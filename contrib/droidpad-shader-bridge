#!/usr/bin/env python3
"""droidpad-shader-bridge — receive DroidPad's control-pad events on comrade and
write them to a state file the shader-backdrop renderer hot-reads.

DroidPad (com.github.umer0586.droidpad on the Pixel) publishes one JSON object per
interaction to MQTT topic "DroidPad/Events"; each object is keyed by the widget id
set in the pad builder (Tilt, Depth, Hue1, Hue2, Pocket, metronom, 1, 2, button,
dpad). This mirrors the renderer's existing state-file convention: the payload
lands in pad.json atomically and the renderer polls it, same as camera_state.txt.

Note the other direction, which nothing here uses: DroidPad SUBSCRIBES to "DroidPad/feed",
and that is the topic you publish to in order to drive its OUTPUT widgets (gauges, switch,
slider, LED). A "metronom" gauge fed from the renderer's beat tracker was tried on
2026-10-15 and dropped as a novelty. We do ignore that topic on the way in (see
on_message): we subscribe to DroidPad/# for discovery, so without the guard anything
published there -- by us or by hand -- would be filed as if it were a pad widget.

Run:  droidpad-shader-bridge [--host 127.0.0.1] [--port 1883] [--topic DroidPad/Events]
"""
import argparse
import json
import os
import sys
import threading
import time

import paho.mqtt.client as mqtt

DEFAULT_STATE = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "pad.json")

ap = argparse.ArgumentParser()
ap.add_argument("--host", default="127.0.0.1")
ap.add_argument("--port", type=int, default=1883)
ap.add_argument("--topic", default="DroidPad/Events")
ap.add_argument("--state-file", default=DEFAULT_STATE)
ap.add_argument("--verbose", action="store_true")
args = ap.parse_args()

FEED_TOPIC = "DroidPad/feed"     # DroidPad's subscribe topic; see the module docstring

state = {}          # widget id -> {type, ...current fields}
seen_topics = set()

# Monotonic event counters. These live HERE, not in the renderer, because we
# see every MQTT message while the renderer only samples at frame rate -- a
# press that lands between two frames would otherwise be lost. The renderer
# diffs these per frame, so no event is ever missed however fast you mash.
derived = {
    "trigger": {},                                   # button id -> press count
    "held": {},                                      # button id -> 1 while down
    "dpad": {"LEFT": 0, "RIGHT": 0, "UP": 0, "DOWN": 0},
    "last_event": {},                                # id -> (kind, t), double-count guard
}


def update_derived(wid, obj):
    """Fold one widget event into the monotonic counters.

    A BUTTON with useClickAction emits CLICK only; one without emits
    PRESS/RELEASE. The 0.25 s guard keeps a widget that somehow emits both for
    one tap from counting twice."""
    wtype = obj.get("type")
    now = time.time()
    if wtype == "BUTTON":
        st = obj.get("state")
        if st == "PRESS":
            last = derived["last_event"].get(wid)
            if not derived["held"].get(wid) and not (
                    last and last[0] == "CLICK" and now - last[1] < 0.25):
                derived["trigger"][wid] = derived["trigger"].get(wid, 0) + 1
                derived["last_event"][wid] = ("PRESS", now)
            derived["held"][wid] = 1
        elif st == "RELEASE":
            derived["held"][wid] = 0
        elif st == "CLICK":
            last = derived["last_event"].get(wid)
            if not (last and now - last[1] < 0.25):
                derived["trigger"][wid] = derived["trigger"].get(wid, 0) + 1
                derived["last_event"][wid] = ("CLICK", now)
    elif wtype == "DPAD":
        # The app emits EITHER a CLICK (tap) or a PRESS/RELEASE pair (longer press) for the same
        # nudge -- "i can do different modes of dpad" (user 2026-10-15) -- and the general pad's
        # dpad sent only PRESS/RELEASE, which nothing counted: a dpad that did nothing at all.
        # Count the edge once whichever shape arrives, with BUTTON's 0.25 s cross-shape guard, and
        # keep a held flag so a mode that repeats PRESS while down still nudges once per press.
        d = obj.get("button")
        if d in derived["dpad"]:
            st = obj.get("state")
            key = "dpad:" + str(d)
            now = time.time()
            if st == "RELEASE":
                derived["held"][key] = 0
            elif st == "PRESS":
                last = derived["last_event"].get(key)
                if not derived["held"].get(key) and not (
                        last and last[0] == "CLICK" and now - last[1] < 0.25):
                    derived["dpad"][d] += 1
                    derived["last_event"][key] = ("PRESS", now)
                derived["held"][key] = 1
            elif st == "CLICK":
                derived["dpad"][d] += 1
                derived["last_event"][key] = ("CLICK", now)


def write_state():
    payload = {"t": time.time(), "widgets": state, "derived": derived}
    tmp = args.state_file + ".tmp"
    try:
        with open(tmp, "w") as fh:
            json.dump(payload, fh, separators=(",", ":"))
            fh.write("\n")
        os.replace(tmp, args.state_file)
    except OSError as e:
        print("state write failed: %s" % e, file=sys.stderr)


def on_connect(client, userdata, flags, reason_code, properties=None):
    print(">>> connected (%s); subscribing %s" % (reason_code, args.topic), file=sys.stderr)
    client.subscribe(args.topic, 0)
    client.subscribe("DroidPad/#", 0)   # discovery: catch any other topic DroidPad uses


def on_message(client, userdata, msg):
    if msg.topic == FEED_TOPIC:
        # DroidPad's OUTPUT topic. We subscribe to DroidPad/# for discovery, so without this
        # anything published there (by a future helper, or by hand with mosquitto_pub) would
        # be filed as if it were a widget the phone had touched.
        return
    if msg.topic not in seen_topics:
        seen_topics.add(msg.topic)
        print(">>> first message on topic %s" % msg.topic, file=sys.stderr)
    try:
        obj = json.loads(msg.payload.decode(errors="ignore"))
    except ValueError:
        if args.verbose:
            print("non-JSON on %s: %r" % (msg.topic, msg.payload[:80]), file=sys.stderr)
        return
    if not isinstance(obj, dict):
        return
    wid = obj.get("id")
    if not wid:
        if args.verbose:
            print("no id: %s" % obj, file=sys.stderr)
        return
    obj.pop("id", None)
    # Stamp the widget with the time of its LAST EVENT. The phone's spring-return controls
    # (JOYSTICK, STEERING_WHEEL) send nothing while a finger is dead still -- the app's onDrag only
    # fires on movement and its onDragEnd is the only thing that sends the 0 -- so the renderer
    # cannot tell "held" from "the release never came" by the value alone. A pad switch mid-drag,
    # an app put in the background, or one QoS-0 message lost (the app publishes at qos 0) leaves
    # the last value latched, and the heartbeat below then keeps it alive FOREVER: observed
    # 2026-10-15, the general pad's Look stick stuck at x=0.657 with the camera panning on its own.
    # With this stamp the renderer can let a stick that nobody has refreshed go back to rest.
    obj["t"] = time.time()
    state[wid] = obj
    update_derived(wid, obj)
    write_state()
    if args.verbose:
        print("%s <- %s" % (wid, obj), file=sys.stderr)


def heartbeat():
    """Rewrite pad.json once a second so its mtime means "the surface is live",
    not "you touched it a moment ago".

    A SWITCH is a latched state, not a stream: without this the file would go
    stale 3 s after you stopped touching the phone and every switch-driven
    mode (frenzy first) would flap off on its own -- the exact thing the switch
    is supposed to be authoritative about."""
    while True:
        time.sleep(1.0)
        write_state()


client = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2, client_id="droidpad-shader-bridge")
client.on_connect = on_connect
client.on_message = on_message
client.connect(args.host, args.port, 30)
threading.Thread(target=heartbeat, daemon=True).start()
client.loop_forever()
