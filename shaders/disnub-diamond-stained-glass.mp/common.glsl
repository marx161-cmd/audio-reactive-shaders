// Disnub-Diamond-Stained-Glass: common code, prepended to every pass.
//
// A gem cut as the great disnub dirhombidodecahedron (Skilling's figure),
// ray-traced with total internal reflection, Fresnel and dispersion, in front
// of a backlit stained-glass window (u_backdrop, with per-pane data in u_glass).
// The backlight rises with the bass and on onsets. Audio arrives in the `bands`
// texture: 120 semitone bands, 0..1.

uniform float u_bass, u_sub, u_lowmid, u_mid, u_highmid, u_presence, u_brilliance, u_onset;
uniform float u_rms, u_steer;
uniform sampler2D u_backdrop;
uniform sampler2D u_glass;

#define TRACKBALL_GAIN 2.6
#define SPIN_MAX       0.6
#define SPIN_TAU       1.6
#define BASE_SPIN      0.06

vec4 quatMul(vec4 a, vec4 b) {
    return vec4(a.w * b.xyz + b.w * a.xyz + cross(a.xyz, b.xyz), a.w * b.w - dot(a.xyz, b.xyz));
}
vec4 quatAxisAngle(vec3 axis, float ang) { return vec4(normalize(axis) * sin(ang * 0.5), cos(ang * 0.5)); }
vec3 quatRot(vec4 q, vec3 v) { return v + 2.0 * cross(q.xyz, cross(q.xyz, v) + q.w * v); }

