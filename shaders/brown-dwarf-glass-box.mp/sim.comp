layout(r32ui, binding = 0) uniform writeonly uimage2D dustImg;
layout(r32ui, binding = 1) uniform writeonly uimage2D cntImg;
uniform ivec2 u_canvas;
void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (c == ivec2(0)) imageStore(cntImg, ivec2(0), uvec4(0u));
    if (c.x >= u_canvas.x || c.y >= u_canvas.y) return;
    imageStore(dustImg, c, uvec4(0u));
}
#endif
#ifdef K_PSPLAT
layout(local_size_x = 256) in;
layout(rgba32f, binding = 0) uniform readonly image2D posImg;
layout(rgba32f, binding = 1) uniform readonly image2D velImg;
layout(r32ui,   binding = 2) uniform uimage2D dustImg;
uniform int u_np;
uniform ivec2 u_canvas;
uniform vec3 u_ro, u_fw, u_rt, u_up;
uniform float u_fov, u_gain;
void main() {
    int i = int(gl_GlobalInvocationID.x);
    if (i >= u_np) return;
    ivec2 q = ivec2(i % DUST_W, i / DUST_W);
    vec4 P = imageLoad(posImg, q), V = imageLoad(velImg, q);
    if (V.w < 0.5 || P.w <= 0.0) return;
    vec3 d = P.xyz - u_ro;
    float z = dot(d, u_fw);
    if (z < 0.05) return;
    vec2 uv = vec2(dot(d, u_rt), dot(d, u_up)) / z;
    vec2 f = uv / (2.0 * u_fov) * float(min(u_canvas.x, u_canvas.y)) + 0.5 * vec2(u_canvas) - 0.5;
    ivec2 b = ivec2(floor(f));
    vec2 w = f - vec2(b);
    float m = P.w * u_gain * DUST_FIX;
    for (int k = 0; k < 4; k++) {
        ivec2 o = ivec2(k & 1, k >> 1), c = b + o;
        if (any(lessThan(c, ivec2(0))) || any(greaterThanEqual(c, u_canvas))) continue;
        float ww = (o.x == 1 ? w.x : 1.0 - w.x) * (o.y == 1 ? w.y : 1.0 - w.y);
        imageAtomicAdd(dustImg, c, uint(m * ww + 0.5));
    }
}
#endif

#ifdef K_CSPLAT
layout(local_size_x = 64) in;
layout(rgba32f, binding = 0) uniform readonly image2D cmImg;
layout(r32ui,   binding = 1) uniform uimage2D outImg;
uniform ivec2 u_canvas, u_cmSize;
uniform vec3 u_ro, u_fw, u_rt, u_up;
uniform float u_fov;
void main() {
    int i = int(gl_GlobalInvocationID.x);
    if (i >= u_cmSize.x * u_cmSize.y) return;
    vec4 P = imageLoad(cmImg, ivec2(i % u_cmSize.x, i / u_cmSize.x));
    if (P.w == 0.0) return;
    vec3 d = P.xyz - u_ro;
    float z = dot(d, u_fw);
    if (z < 0.05) return;
    float H = float(min(u_canvas.x, u_canvas.y));
    vec2 f = vec2(dot(d, u_rt), dot(d, u_up)) / z / (2.0 * u_fov) * H + 0.5 * vec2(u_canvas);
    float rad = (P.w > 0.0 ? 0.003 + 0.007 * min(P.w / 1.65, 1.0) : -P.w) * H / (2.0 * u_fov * z);
    rad = max(rad, 0.7);
    float br = P.w > 0.0 ? P.w : 1.0;
    int R = int(min(ceil(2.5 * rad), 90.0));
    rad = min(rad, 36.0);
    ivec2 c0 = ivec2(f);
    for (int y = -R; y <= R; y++) for (int x = -R; x <= R; x++) {
        ivec2 c = c0 + ivec2(x, y);
        if (any(lessThan(c, ivec2(0))) || any(greaterThanEqual(c, u_canvas))) continue;
        vec2 o = vec2(c) + 0.5 - f;
        float w = br * exp(-dot(o, o) / (rad * rad));
        if (w > 0.002) imageAtomicAdd(outImg, c, uint(w * 1000.0));
    }
}
#endif
