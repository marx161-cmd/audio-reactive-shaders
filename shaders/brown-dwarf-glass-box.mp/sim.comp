#define C_S        0.0015
#define NU         4.0e-6
#define TAU_RELAX  300.0
#define TAU_DRAIN  60.0
#define SIG_FLOOR  0.02
#define SIG_MAX    2.5
#define SINK_HILL  0.6
#define V_MAX      0.03
#define EMPTY_DAMP 0.85

float hash11(float p) { p = fract(p * 0.1031); p *= p + 33.33; p *= p + p; return fract(p); }
float noise1(float x) { float i = floor(x), f = fract(x); f = f * f * (3.0 - 2.0 * f); return mix(hash11(i), hash11(i + 1.0), f); }

float sigma0(float r) {
    float s = smoothstep(0.320, 0.332, r) * (1.0 - smoothstep(2.860, 2.875, r));
    float b = 0.55 * noise1(r * 28.0) + 0.30 * noise1(r * 95.0 + 7.0) + 0.15 * noise1(r * 310.0 + 3.0);
    s *= mix(0.12, 1.15, smoothstep(0.36, 0.62, b));
    s *= 0.70 + 0.30 * smoothstep(0.33, 1.20, r);
    s *= smoothstep(0.040, 0.055, abs(r - 1.9));
    return s;
}

