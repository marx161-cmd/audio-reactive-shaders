#define DUST_W       1024
#define DUST_FIX     1000.0
uint dHash(uint x) { x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16; return x; }
float dRnd(inout uint s) { s = dHash(s + 0x9e3779b9u); return float(s) / 4294967296.0; }
#ifdef K_RZERO
