#ifdef K_NOTES
layout(local_size_x = 12) in;
layout(rgba32f, binding = 0) uniform image2D noteImg;
layout(rgba32f, binding = 1) uniform image2D spokeImg;
uniform sampler2D stems;
uniform float iTime;
uniform float u_dt;
uniform float u_kick, u_drum_mid, u_drum_high;
uniform float u_ms_change, u_ms_drop_in, u_ms_source;
uniform float u_pad_moon_gate;
uniform float u_pad_big_gate;
uniform float u_pad_moon_fire;
uniform float u_pad_big_fire;
#define NT_LEVEL_T 0.08
#define DR_ON      0.45
#define DR_OFF     0.20
#define MOON_REF   0.25
#define BIG_REF    1.5
#define BIG_LIVE_S 40.0
#define BIG_LIVE_K 0.80
#define N_SPOKE    32
float nHash(float n) { return fract(sin(n * 78.233 + 1.31) * 43758.5453); }
void fireMoon(int pc, float strength) {
    vec4 s = imageLoad(noteImg, ivec2(pc, 0)), c = imageLoad(noteImg, ivec2(pc, 1));
    s.z = iTime; s.w = strength; c.x += 1.0;
    imageStore(noteImg, ivec2(pc, 0), s); imageStore(noteImg, ivec2(pc, 1), c);
}
void fireBig(int pc, float strength) {
    vec4 p0 = imageLoad(noteImg, ivec2(12, 0)), p1 = imageLoad(noteImg, ivec2(12, 1));
    if (iTime - p0.z < BIG_REF) return;
    imageStore(noteImg, ivec2(12, 0), vec4(0.0, 0.0, iTime, strength));
    imageStore(noteImg, ivec2(12, 1), vec4(p1.x + 1.0, float(pc), 0.0, 0.0));
}
void main() {
    int p = int(gl_GlobalInvocationID.x);
    float L = 0.0;
    for (int b = (p + 3) % 12; b < 108; b += 12) L = max(L, texelFetch(stems, ivec2(b, 2), 0).r);
    vec4 s = imageLoad(noteImg, ivec2(p, 0));
    if (any(isnan(s))) s = vec4(0.0, 0.0, -100.0, 0.0);
    s.x += (L - s.x) * (1.0 - exp(-u_dt / NT_LEVEL_T));
    imageStore(noteImg, ivec2(p, 0), s);
    memoryBarrierImage(); barrier();
    if (p != 0) return;
    int first = -1, second = -1; float l1 = 0.02, l2 = 0.02;
    for (int k = 0; k < 12; k++) {
        vec4 sk = imageLoad(noteImg, ivec2(k, 0));
        if (iTime - sk.z < MOON_REF) continue;
        if (sk.x > l1) { second = first; l2 = l1; first = k; l1 = sk.x; }
        else if (sk.x > l2) { second = k; l2 = sk.x; }
    }
    vec4 st = imageLoad(noteImg, ivec2(0, 2)), st2 = imageLoad(noteImg, ivec2(1, 2));
    if (any(isnan(st))) st = vec4(1.0, 1.0, 1.0, u_ms_change);
    if (any(isnan(st2))) st2 = vec4(-1.0, 0.0, 0.0, 0.0);
    if (u_pad_moon_fire > 0.5) {
        int k = first;
        if (k < 0) {
            float bl = -1.0;
            for (int j = 0; j < 12; j++) {
                float lj = imageLoad(noteImg, ivec2(j, 0)).x;
                if (lj > bl) { bl = lj; k = j; }
            }
            if (bl < 0.02) { k = int(mod(st2.z, 12.0)); st2.z += 1.0; }
        }
        if (k >= 0) fireMoon(k, 0.9);
    }
    if (u_pad_big_fire > 0.5) fireBig(first >= 0 ? first : 0, 1.0);
    if (st.x > 0.5 && u_kick > DR_ON) {
        st.x = 0.0;
        if (u_pad_moon_gate > 0.5 && first >= 0) fireMoon(first, clamp(u_kick, 0.5, 1.0));
        vec4 p0 = imageLoad(noteImg, ivec2(12, 0));
        if (u_pad_big_gate > 0.5 && u_ms_source < 0.5 && u_kick > BIG_LIVE_K && iTime - p0.z > BIG_LIVE_S && first >= 0) fireBig(first, 1.0);
    } else if (u_kick < DR_OFF) st.x = 1.0;
    if (st.y > 0.5 && u_drum_mid > DR_ON) {
        st.y = 0.0;
        int k = second >= 0 ? second : first;
        if (u_pad_moon_gate > 0.5 && k >= 0 && iTime - imageLoad(noteImg, ivec2(k, 0)).z >= MOON_REF) fireMoon(k, clamp(u_drum_mid, 0.5, 1.0));
    } else if (u_drum_mid < DR_OFF) st.y = 1.0;
    if (st.z > 0.5 && u_drum_high > DR_ON) {
        st.z = 0.0;
        float n = st2.y; st2.y += 1.0;
        int slot = int(mod(n, float(N_SPOKE)));
        float camAng = 0.006 * iTime - 1.5707963;
        float th = camAng + 6.2831853 * (0.1 + 0.8 * nHash(n * 3.1 + iTime));
        float rc = 0.35 + 1.85 * nHash(n * 7.7 + 0.3);
        imageStore(spokeImg, ivec2(slot, 0), vec4(rc, th, iTime, clamp(u_drum_high, 0.5, 1.0)));
        imageStore(spokeImg, ivec2(slot, 1), vec4(0.12 + 0.22 * nHash(n * 5.3), 0.008 + 0.014 * nHash(n * 2.9), 0.0, 0.0));
    } else if (u_drum_high < DR_OFF) st.z = 1.0;
    if (u_ms_change != st.w) { st.w = u_ms_change; if (u_pad_big_gate > 0.5 && first >= 0) fireBig(first, 1.0); }
    if (u_pad_big_gate > 0.5 && u_ms_source > 0.5 && st2.x > 0.0 && st2.x < 1.0 && (u_ms_drop_in <= 0.02 || u_ms_drop_in > st2.x + 1.0))
        fireBig(first >= 0 ? first : 0, 1.0);
    st2.x = u_ms_drop_in;
    imageStore(noteImg, ivec2(0, 2), st);
    imageStore(noteImg, ivec2(1, 2), st2);
}
#endif

