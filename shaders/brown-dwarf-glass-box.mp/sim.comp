}
#endif
#ifdef K_PSEED
layout(local_size_x = 256) in;
layout(rgba32f, binding = 0) uniform writeonly image2D posImg;
layout(rgba32f, binding = 1) uniform writeonly image2D velImg;
uniform sampler2D u_src;
uniform sampler2D u_phase;
uniform int u_np;
uniform float u_seed;
void main() {
    int i = int(gl_GlobalInvocationID.x);
    if (i >= u_np) return;
    uint sd = dHash(uint(i) * 747796405u + uint(u_seed));
    float r = sqrt(mix(R_IN * R_IN, R_OUT * R_OUT, dRnd(sd)));
    float th = 6.28318530718 * dRnd(sd);
    int j = clamp(int((r - R_IN) / DR), 0, NR - 1);
    float phi = texelFetch(u_phase, ivec2(j, 0), 0).x;
    int k = int(floor(mod(th - phi, 6.28318530718) / DTH)) % NT;
    vec4 F = texelFetch(u_src, ivec2(k, j), 0);
    vec2 er = vec2(cos(th), sin(th)), et = vec2(-er.y, er.x);
    vec2 v = er * F.y + et * (pow(r, -0.5) + F.z);
    ivec2 q = ivec2(i % DUST_W, i / DUST_W);
    imageStore(posImg, q, vec4(r * er.x, 0.0, r * er.y, F.x));
    imageStore(velImg, q, vec4(v.x, 0.0, v.y, F.x > 2e-3 ? 1.0 : 0.0));
}
#endif
#ifdef K_PMOVE
layout(local_size_x = 256) in;
layout(rgba32f, binding = 0) uniform image2D posImg;
layout(rgba32f, binding = 1) uniform image2D velImg;
layout(r32ui,   binding = 2) uniform uimage2D cntImg;
uniform int u_np, u_nsub;
uniform float u_h;
uniform vec4 u_hole;
uniform float u_holeR;
uniform vec3 u_g;
uniform vec3 u_bx, u_by, u_bz, u_bh;
vec3 dAcc(vec3 x) {
    float r2 = dot(x, x);
    vec3 a = -x / (r2 * sqrt(r2)) + u_g;
    if (u_hole.w > 0.0) { vec3 d = u_hole.xyz - x; float q = dot(d, d) + 0.0025; a += u_hole.w * d / (q * sqrt(q)); }
    return a;
}
void main() {
    int i = int(gl_GlobalInvocationID.x);
    if (i >= u_np) return;
    ivec2 q = ivec2(i % DUST_W, i / DUST_W);
    vec4 P = imageLoad(posImg, q), V = imageLoad(velImg, q);
    if (V.w < 0.5) return;
    vec3 x = P.xyz, v = V.xyz;
    for (int s = 0; s < u_nsub; s++) {
        v += 0.5 * u_h * dAcc(x); x += u_h * v; v += 0.5 * u_h * dAcc(x);
        vec3 b = vec3(dot(x, u_bx), dot(x, u_by), dot(x, u_bz)), bv = vec3(dot(v, u_bx), dot(v, u_by), dot(v, u_bz));
        for (int k = 0; k < 3; k++) if (abs(b[k]) > u_bh[k]) { b[k] = sign(b[k]) * u_bh[k]; if (bv[k] * b[k] > 0.0) bv[k] *= -0.85; }
        x = b.x * u_bx + b.y * u_by + b.z * u_bz; v = bv.x * u_bx + bv.y * u_by + bv.z * u_bz;
        if (dot(x, x) < DW_R * DW_R || (u_hole.w > 0.0 && length(x - u_hole.xyz) < u_holeR)) { V.w = 0.0; break; }
    }
    if (any(isnan(x)) || any(isnan(v))) V.w = 0.0;
    imageStore(posImg, q, vec4(x, P.w));
    imageStore(velImg, q, vec4(v, V.w));
    if (V.w > 0.5) imageAtomicAdd(cntImg, ivec2(0), 1u);
}
#endif
