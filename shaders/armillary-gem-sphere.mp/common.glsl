}
vec3 saphLight(vec3 p) { return SAPH_COL * saphPulse() * SAPH_LIGHT / (dot(p, p) + 0.003); }
bool barHit(vec3 o, vec3 d, int base, out float tN, out int jN, out float tF, out int jF) {
    tN = -1e9; tF = 1e9; jN = -1; jF = -1;
