        if (abs(dn) < 1e-9) { if (dist < 0.0) return false; continue; }
        float t = dist / dn;
        if (dn < 0.0) { if (t > tN) { tN = t; jN = j; } }
        else          { if (t < tF) { tF = t; jF = j; } }
