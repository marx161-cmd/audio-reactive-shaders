}
float gemNearest(vec3 o, vec3 d, float tMax, out int bar, out int face) {
    float best = tMax; bar = -1; face = -1;
    for (int k = 0; k < 3; k++) {
        mat3 iG = transpose(gM[k]);
        vec3 ol = iG * o, dl = iG * d;
        float Rb = RING_R[k] + RING_TUBE[k] * BAR_EXT_R / C30 + 0.005, zb = RING_TUBE[k] * BAR_EXT_Z + 0.002;
        float b = dot(ol, dl), c = dot(ol, ol) - Rb * Rb, h = b * b - c;
        if (h < 0.0) continue;
        h = sqrt(h);
        float t0 = -b - h, t1 = -b + h;
        if (abs(dl.z) > 1e-7) {
            float za = (-zb - ol.z) / dl.z, zc = (zb - ol.z) / dl.z;
            t0 = max(t0, min(za, zc)); t1 = min(t1, max(za, zc));
        } else if (abs(ol.z) > zb) continue;
        if (t1 < GEPS || t0 > best) continue;
        t0 = max(t0, GEPS);
        vec3 pa = ol + dl * t0, pb = ol + dl * t1;
        float ia = floor((atan(pa.y, pa.x) - RING_VOFF[k]) / A60), ib = floor((atan(pb.y, pb.x) - RING_VOFF[k]) / A60);
        int i0 = int(mod(ia, 6.0)), i1 = int(mod(ib, 6.0));
        int span = (i1 - i0 + 6) % 6;
        bool all6 = span > 1 && span < 5;
        int nb = all6 ? 6 : (span == 0 ? 1 : 2);
        int start = all6 ? 0 : (span == 5 ? i1 : i0);
        for (int q = 0; q < 6; q++) {
            if (q >= nb) break;
            int i = (start + q) % 6;
            float tN, tF; int jN, jF;
            int base = (k * 6 + i) * 8;
            if (barHit(ol, dl, base, tN, jN, tF, jF) && tN > GEPS && tN < best) { best = tN; bar = k * 6 + i; face = jN; }
        }
    }
    return best;
}
float gemIOR(int k, int ch, int pol, vec3 dLocal, int bar) {
    float lam = LAMBDA_UM[ch];
    float n = GEM_CA[k] + GEM_CB[k] * DISP_EXAG / (lam * lam);
    if (k == 0 && pol == 1) {
        float th0 = RING_VOFF[0] + A60 * float(bar - 0), th1 = th0 + A60;
        vec3 u = normalize(vec3(cos(th1) - cos(th0), sin(th1) - sin(th0), 0.0));
        float ne = n + BIREF_DN * BIREF_EXAG;
        float cs = dot(dLocal, u), sn2 = max(1.0 - cs * cs, 0.0);
        n = inversesqrt(cs * cs / (n * n) + sn2 / (ne * ne));
    }
    return n;
}
float fresnelD(float cosi, float n1, float n2) {
    float s = n1 / n2 * sqrt(max(1.0 - cosi * cosi, 0.0));
    if (s >= 1.0) return 1.0;
    float cost = sqrt(1.0 - s * s);
    float rs = (n1 * cosi - n2 * cost) / (n1 * cosi + n2 * cost);
    float rp = (n1 * cost - n2 * cosi) / (n1 * cost + n2 * cosi);
    return 0.5 * (rs * rs + rp * rp);
}

#define N_CON        6
#define CON_R        0.014
#define CON_TIP      40.0
const vec3 CON_COLS[3] = vec3[](vec3(0.04, 0.22, 1.00),
                                vec3(1.00, 0.97, 0.92),
                                vec3(1.00, 0.04, 0.02));
const float CON_GAIN[3] = float[](1.0, 1.6, 1.0);
#define CON_EMIT     4.5
#define CON_STONE_R  0.095
vec3 keepHue(vec3 c) { float m = max(max(c.r, c.g), c.b); return m > 1.0 ? c / m : c; }
vec3 conCol(int c) { return CON_COLS[c / 2] * CON_GAIN[c / 2]; }
#define CON_PULSE    0.5
vec3 gCA[6], gCB[6];
void buildConnectors() {
    vec3 ax1 = gM[0] * pivDir(PIV_MID), ax2 = gM[1] * pivDir(PIV_INN), ax3 = gM[2] * pivDir(0.0);
    for (int s = 0; s < 2; s++) {
        float sg = s == 0 ? 1.0 : -1.0;
        float am = PIV_MID + (s == 0 ? 0.0 : 3.14159265), ai = PIV_INN + (s == 0 ? 0.0 : 3.14159265);
        gCA[s]     = sg * ax1 * hexR(1, am, 0.0); gCB[s]     = sg * ax1 * hexR(0, am, 0.0);
        gCA[2 + s] = sg * ax2 * hexR(2, ai, 0.0); gCB[2 + s] = sg * ax2 * hexR(1, ai, 0.0);
        gCA[4 + s] = sg * ax3 * CON_STONE_R;             gCB[4 + s] = sg * ax3 * hexR(2, 0.0, 0.0);
    }
}
float conPulse() { return 1.0 + CON_PULSE * S(4).y; }
bool conHit(vec3 o, vec3 d, int c, out float tN, out vec3 nW) {
    vec3 A = gCA[c], B = gCB[c];
    vec3 u = B - A; float L = length(u); u /= L;
    vec3 C = 0.5 * (A + B);
    vec3 w0 = o - C;
    vec3 e1 = normalize(abs(u.x) < 0.9 ? cross(u, vec3(1.0, 0.0, 0.0)) : cross(u, vec3(0.0, 1.0, 0.0)));
    vec3 e2 = cross(u, e1);
    vec3 ol = vec3(dot(w0, e1), dot(w0, u), dot(w0, e2)), dl = vec3(dot(d, e1), dot(d, u), dot(d, e2));
    float ca = cos(radians(CON_TIP)), sa = sin(radians(CON_TIP));
    float tipL = CON_R * ca / sa;
    float H = max(0.5 * L - tipL, 0.0);
    float D = CON_R * ca + H * sa;
    tN = -1e9; float tF = 1e9; vec3 nl = vec3(0.0);
    for (int j = 0; j < 18; j++) {
        float th = 1.04719755 * float(j % 6);
        vec3 n = j < 6 ? vec3(cos(th), 0.0, sin(th)) : vec3(cos(th) * ca, (j < 12 ? sa : -sa), sin(th) * ca);
        float wpl = j < 6 ? CON_R : D;
        float dn = dot(dl, n), dist = wpl - dot(ol, n);
        if (abs(dn) < 1e-9) { if (dist < 0.0) return false; continue; }
        float t = dist / dn;
        if (dn < 0.0) { if (t > tN) { tN = t; nl = n; } }
        else          { if (t < tF) tF = t; }
    }
    if (tN > tF || tF < 0.0) return false;
    nW = nl.x * e1 + nl.y * u + nl.z * e2;
