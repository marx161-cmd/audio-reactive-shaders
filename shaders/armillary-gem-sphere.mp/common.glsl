#define ENV_BASE     vec3(0.05, 0.06, 0.09)
#define ENV_LIT      2.0
#define SAPH_GLINT   4.0
mat3 gS;
bool saphHit(vec3 o, vec3 d, out float tN, out int jN, out float tF, out int jF) {
    vec3 ol = transpose(gS) * o, dl = transpose(gS) * d;
    tN = -1e9; tF = 1e9; jN = -1; jF = -1;
