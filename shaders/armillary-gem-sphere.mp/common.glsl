}
float conNearest(vec3 o, vec3 d, float tMax, out int ci, out vec3 nW) {
    float best = tMax; ci = -1; nW = vec3(0.0);
    for (int c = 0; c < N_CON; c++) {
        vec3 a = gCA[c], v = gCB[c] - a, w = o - a;
        float vv = max(dot(v, v), 1e-8), dv = dot(d, v), dw = dot(d, w), vw = dot(v, w);
        float den = vv - dv * dv;
        float tsg = clamp(den > 1e-9 * vv ? (vw - dv * dw) / den : 0.5, 0.0, 1.0);
        float s = max(dot(a + v * tsg - o, d), 0.0);
        tsg = clamp(dot(o + d * s - a, v) / vv, 0.0, 1.0);
        s = max(dot(a + v * tsg - o, d), 0.0);
        if (s > best + CON_R * 3.0 || length(o + d * s - (a + v * tsg)) > CON_R * 1.8) continue;
        float t; vec3 n;
        if (conHit(o, d, c, t, n) && t > 1e-4 && t < best) { best = t; ci = c; nW = n; }
    }
    return best;
}
float segDistC(vec3 x, vec3 a, vec3 b) {
    vec3 ab = b - a;
    float t = clamp(dot(x - a, ab) / max(dot(ab, ab), 1e-8), 0.0, 1.0);
    return length(x - a - ab * t);
}

uniform sampler2D u_backdrop;
uniform sampler2D u_bg_normal;
uniform sampler2D u_bg_depth;
#define BG_LOD       0.52
#define BG_AMB       0.05
#define BG_SAPH      0.7
#define BG_CON       1.0
const float BG_CON_PAIR[3] = float[](0.33, 1.0, 1.0);
#define BG_Z        -2.4
#define BG_DEPTH     2.0
#define BG_DEPTH_SRC 0.0
#define BG_LOD_D     2.52
#define BG_SHADOW    1
#define BG_FIRE      1.0
float bgZ(vec2 st) {
    vec2 uv = (st * 2.0 - 1.0) * iResolution.xy / iResolution.y;
    float dTun = clamp(1.0 - length(uv) / 1.3, 0.0, 1.0);
    float dMar = textureLod(u_bg_depth, st, BG_LOD_D).r;
    return BG_Z - BG_DEPTH * mix(dTun, dMar, BG_DEPTH_SRC);
}
vec3 bgPoint(vec2 st) {
    vec2 uv = (st * 2.0 - 1.0) * iResolution.xy / iResolution.y;
    float z = bgZ(st);
    return vec3(uv * FOV * (CAM_Z - z), z);
}
vec2 bgHitSt(vec3 o, vec3 d) {
    vec3 P = o + d * 3.0;
    if (d.z < -0.02) {
        float z = BG_Z;
        for (int i = 0; i < 4; i++) {
            P = o + d * ((z - o.z) / d.z);
            vec2 uv = P.xy / ((CAM_Z - P.z) * FOV);
            z = bgZ((uv * iResolution.y + iResolution.xy) * 0.5 / iResolution.xy);
        }
        P = o + d * ((z - o.z) / d.z);
    }
    vec2 uv = P.xy / ((CAM_Z - P.z) * FOV);
    return (uv * iResolution.y + iResolution.xy) * 0.5 / iResolution.xy;
}
void shadowPass(vec3 x, out vec3 T, out vec3 offR, out vec3 offB) {
    T = vec3(1.0); offR = vec3(0.0); offB = vec3(0.0);
    float dist = length(x);
    vec3 d = -x / dist;
    float tmax = dist - SAPH_R * 0.7;
    if (tmax <= 0.0) return;
    for (int k = 0; k < 3; k++) {
        mat3 iG = transpose(gM[k]);
        vec3 ol = iG * x, dl = iG * d;
        float Rb = RING_R[k] + RING_TUBE[k] * BAR_EXT_R / C30 + 0.005, zb = RING_TUBE[k] * BAR_EXT_Z + 0.002;
        float b = dot(ol, dl), c = dot(ol, ol) - Rb * Rb, h = b * b - c;
        if (h < 0.0) continue;
        h = sqrt(h);
        float t0 = -b - h, t1 = -b + h;
        if (abs(dl.z) > 1e-7) {
            float za = (-zb - ol.z) / dl.z, zc = (zb - ol.z) / dl.z;
            t0 = max(t0, min(za, zc)); t1 = min(t1, max(za, zc));
        } else if (abs(ol.z) > zb) continue;
        t0 = max(t0, 0.0); t1 = min(t1, tmax);
        if (t1 <= t0) continue;
        vec3 nI = vec3(GEM_CA[k]) + GEM_CB[k] * DISP_EXAG / (LAMBDA_UM * LAMBDA_UM);
        for (int i = 0; i < 6; i++) {
            float tN, tF; int jN, jF;
            int base = (k * 6 + i) * 8;
            if (!barHit(ol, dl, base, tN, jN, tF, jF)) continue;
            float a0 = max(tN, 0.0), a1 = min(tF, tmax);
            if (a1 <= a0) continue;
            T *= exp(-GEM_SIGMA[k] * (a1 - a0));
            bool outN = tN >= 0.0 && jN >= 2, inF = tF <= tmax && jF >= 2;
            vec3 nN = BP[base + jN].xyz, nF = BP[base + jF].xyz;
            vec3 L = -dl;
            vec3 o3[3];
            bool ok = outN && inF;
            for (int ch = 0; ch < 3; ch++) {
                float n = nI[ch];
                if (outN) T[ch] *= 1.0 - fresnelD(clamp(-dot(dl, nN), 0.0, 1.0), 1.0, n);
                if (inF)  T[ch] *= 1.0 - fresnelD(clamp(dot(dl, nF), 0.0, 1.0), n, 1.0);
                o3[ch] = vec3(0.0);
                if (!ok) continue;
                vec3 tr = refract(L, nF, 1.0 / n);
                vec3 o = dot(tr, tr) > 0.0 ? refract(tr, -nN, n) : vec3(0.0);
                if (dot(o, o) == 0.0) T[ch] = 0.0;
                o3[ch] = o;
            }
            if (ok && dot(o3[1], o3[1]) > 0.0) {
                if (dot(o3[0], o3[0]) > 0.0) offR += gM[k] * (tN * (o3[0] - o3[1]));
                if (dot(o3[2], o3[2]) > 0.0) offB += gM[k] * (tN * (o3[2] - o3[1]));
            }
        }
    }
}
vec3 shadowRGB(vec3 x) {
    vec3 T, oR, oB, Tr, Tb, u, v;
    shadowPass(x, T, oR, oB);
    shadowPass(x - oR * BG_FIRE, Tr, u, v);
    shadowPass(x - oB * BG_FIRE, Tb, u, v);
    return vec3(Tr.r, T.g, Tb.b);
}
vec3 bgLight(vec2 st) {
    vec3 N = normalize(textureLod(u_bg_normal, st, BG_LOD_D).xyz);
    vec3 P = bgPoint(st);
    float r2 = dot(P, P);
    float lam = max(-dot(N, P) * inversesqrt(r2), 0.0);
    vec3 E = vec3(0.0);
    if (lam > 0.0) {
        E = SAPH_COL * saphPulse() * BG_SAPH * (BG_Z * BG_Z / r2) * lam;
        if (BG_SHADOW == 1) E *= shadowRGB(P);
    }
    float cp = conPulse();
    for (int k = 0; k < N_CON; k++) {
        vec3 a = gCA[k], ab = gCB[k] - a;
        vec3 v = a + ab * clamp(dot(P - a, ab) / max(dot(ab, ab), 1e-8), 0.0, 1.0) - P;
        float d2 = dot(v, v);
        E += conCol(k) * cp * BG_CON * BG_CON_PAIR[k / 2] / (d2 + 0.05) * max(dot(N, v) * inversesqrt(d2), 0.0);
    }
    return E;
}
vec3 backdropAt(vec2 st) {
    return textureLod(u_backdrop, st, BG_LOD).rgb * (BG_AMB + textureLod(iChannel3, st, 0.0).rgb);
}
