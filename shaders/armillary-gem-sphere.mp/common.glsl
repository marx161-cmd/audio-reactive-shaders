#define C30  0.86602540
#define A60  1.04719755
#define A30  0.52359878
float hexRel(int k, float a) { return mod(a - RING_VOFF[k], A60) - A30; }
float hexR(int k, float a, float off) { return (RING_R[k] * C30 + off) / cos(hexRel(k, a)); }
vec3 hexPt(int k, float a, float off) { float r = hexR(k, a, off); return vec3(cos(a) * r, sin(a) * r, 0.0); }
vec3 hexEdgeN(int k, float a) { float psi = a - hexRel(k, a); return vec3(cos(psi), sin(psi), 0.0); }
float sdHex2(vec2 p, float r) {
    const vec3 kk = vec3(-0.866025404, 0.5, 0.577350269);
    p = abs(p);
    p -= 2.0 * min(dot(kk.xy, p), 0.0) * kk.xy;
    p -= vec2(clamp(p.x, -kk.z * r, kk.z * r), r);
    return length(p) * sign(p.y);
}
float ringSD(vec3 pl, int k) {
    float a = atan(pl.y, pl.x);
    vec3 e = hexEdgeN(k, a);
    vec2 q = vec2(dot(pl.xy, e.xy) - RING_R[k] * C30, pl.z);
    return sdHex2(q.yx, RING_TUBE[k]);
}
#define SPIKE_H      0.030
#define SPIKE_RB     0.011
#define SPIKE_TIP    0.0015
#define SPIKE_SIDE_H 0.55
#define SPIKE_SIDE_D 1.7
#define SPIKE_BLEND  0.010
#define SPIKE_BOUND  (0.5 * SPIKE_H + SPIKE_RB * (SPIKE_SIDE_D + 0.7) + 0.005)

float sdRoundCone(vec2 q, float r1, float r2, float h) {
    float b = (r1 - r2) / h, a = sqrt(1.0 - b * b);
    float k = dot(q, vec2(-b, a));
    if (k < 0.0) return length(q) - r1;
    if (k > a * h) return length(q - vec2(0.0, h)) - r2;
    return dot(q, vec2(a, b)) - r1;
}
float smin(float a, float b, float k) {
    float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
    return mix(b, a, h) - k * h * (1.0 - h);
}
float spikeCluster(vec3 pl, vec3 bp, vec3 ax) {
    vec3 v = pl - bp;
    float bound = length(v - ax * (0.5 * SPIKE_H)) - SPIKE_BOUND;
    if (bound > 0.01) return bound;
    float h = dot(v, ax);
    vec3 rv = v - h * ax;
    float d = sdRoundCone(vec2(length(rv), h + 0.004), SPIKE_RB, SPIKE_TIP, SPIKE_H + 0.004);
    vec3 e1 = normalize(abs(ax.x) < 0.9 ? cross(ax, vec3(1.0, 0.0, 0.0)) : cross(ax, vec3(0.0, 1.0, 0.0)));
    vec3 e2 = cross(ax, e1);
    for (int i = 0; i < 6; i++) {
        float a = 1.04719755 * float(i);
        vec3 c = (cos(a) * e1 + sin(a) * e2) * SPIKE_RB * SPIKE_SIDE_D;
        vec3 w = rv - c;
        d = min(d, sdRoundCone(vec2(length(w), h + 0.004), SPIKE_RB * 0.7, SPIKE_TIP, SPIKE_H * SPIKE_SIDE_H + 0.004));
    }
    return d;
}
float spikesSD(vec3 pl, int k) {
    float d = 1e9;
    for (int s = 0; s < 2; s++) {
        float sg = s == 0 ? 1.0 : -1.0;
        if (k == 0) {
            d = min(d, spikeCluster(pl, vec3(0.0, sg * (RING_R[0] - RING_TUBE[0]), 0.0), vec3(0.0, -sg, 0.0)));
        } else if (k == 1) {
            d = min(d, spikeCluster(pl, vec3(0.0, sg * (RING_R[1] + RING_TUBE[1]), 0.0), vec3(0.0, sg, 0.0)));
            d = min(d, spikeCluster(pl, vec3(sg * (RING_R[1] - RING_TUBE[1]), 0.0, 0.0), vec3(-sg, 0.0, 0.0)));
        } else {
            d = min(d, spikeCluster(pl, vec3(sg * (RING_R[2] + RING_TUBE[2]), 0.0, 0.0), vec3(sg, 0.0, 0.0)));
        }
    }
    return d;
}

float sceneSD(vec3 p, out int id) {
    float best = 1e9; id = -1;
    for (int k = 0; k < N_RINGS; k++) {
        vec3 pl = transpose(gM[k]) * p;
        float d = smin(ringSD(pl, k), spikesSD(pl, k), SPIKE_BLEND);
        if (d < best) { best = d; id = k; }
    }
    return best;
}
float sceneSD(vec3 p) { int id; return sceneSD(p, id); }

#define LIGHTNING    0
