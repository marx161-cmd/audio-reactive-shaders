float saphPulse() { return SAPH_BASE + SAPH_BASS * S(4).x; }
mat3 saphRot() {
    return rotX(-1.25) * rotZ(0.35 * u_rms_accum + 0.05 * iTime);
}
float flicker() {
    return 0.85 + 0.15 * sin(iTime * 35.0) * cos(iTime * 60.0) + 0.3 * u_onset;
}
vec3 lightCol() { return (ELEC_BLUE * 1.5 + HOT_WHITE * 0.8) / 2.3; }

const float RING_HUE_H[3] = float[](0.3, 0.58, 0.0);
const vec3 RING_RGB[3] = vec3[](vec3(0.104, 1.0, 0.0), vec3(0.0, 0.52998, 1.0), vec3(1.0, 0.0, 0.0));
float flashEnvelope(float dt, float tau) {
    if (dt < 0.0) return 0.0;
    float leader = smoothstep(0.0, LEADER_DUR, dt)
                 * (1.0 - smoothstep(LEADER_DUR, LEADER_DUR * 1.3, dt)) * LEADER_PEAK;
    float mainStroke = dt >= LEADER_DUR ? exp(-(dt - LEADER_DUR) / tau) : 0.0;
    float d1 = (dt - RESTRIKE_1_TIME) / RESTRIKE_WIDTH;
    float d2 = (dt - RESTRIKE_2_TIME) / RESTRIKE_WIDTH;
    return max(leader, mainStroke)
         + RESTRIKE_AMOUNT * exp(-d1 * d1)
         + RESTRIKE_AMOUNT * 0.7 * exp(-d2 * d2);
}

void setupGimbal() {
    mat3 base = rotY(BASE_YAW + S(7).x) * rotZ(BASE_ROLL);
    gM[0] = base * rotX(S(0).x);
    gM[1] = gM[0] * rotAxisM(pivDir(PIV_MID), S(1).x);
    gM[2] = gM[1] * rotAxisM(pivDir(PIV_INN), S(2).x);
}

void buildBolts(out vec3 bA[10], out vec3 bB[10], out float bFl[10], out int bK[10], out int bTile[10]) {
    vec3 ax1 = gM[0] * pivDir(PIV_MID);
    vec3 ax2 = gM[1] * pivDir(PIV_INN);
    vec3 ax3 = gM[2] * vec3(0.0, 1.0, 0.0);
    vec3 axOuter = gM[0] * vec3(1.0, 0.0, 0.0);
    float bps = max(S(3).y, 1e-3);
    for (int i = 0; i < 10; i++) {
        float sgn = (i % 2 == 0) ? 1.0 : -1.0;
        bFl[i] = 0.0;
        if (i < 6) {
            int j = i / 2;
            vec3 ax = j == 0 ? ax1 : (j == 1 ? ax2 : ax3);
            float r0 = j == 0 ? hexR(1, PIV_MID, RING_TUBE[1]) : (j == 1 ? hexR(2, PIV_INN, RING_TUBE[2]) : ORB_R);
            float r1 = j == 0 ? hexR(0, PIV_MID, -RING_TUBE[0]) : (j == 1 ? hexR(1, PIV_INN, -RING_TUBE[1]) : hexR(2, 1.5707963, -RING_TUBE[2]));
            float rate = RING_NOTES[j];
            float note = floor(u_beat_count * rate);
            float since = fract(u_beat_count * rate) / (rate * bps);
            bA[i] = sgn * ax * r0; bB[i] = sgn * ax * r1;
            bK[i] = min(j + 1, 2);
            bTile[i] = int(floor(lhash(vec3(note, float(i), 3.7)) * float(BOLT_N))) % BOLT_N;
            bFl[i] = flashEnvelope(since, BOLT_TAU[j]) * (0.6 + 0.4 * S(4)[j]);
        } else {
            int k = i < 8 ? 1 : 0;
            vec3 dir = k == 1 ? ax1 : axOuter;
            float rate = RING_NOTES[2];
            float note = floor(u_beat_count * rate);
            float since = fract(u_beat_count * rate) / (rate * bps);
            bA[i] = sgn * dir * ORB_R; bB[i] = sgn * dir * hexR(k, k == 1 ? 1.5707963 : 0.0, -RING_TUBE[k]);
            bK[i] = k;
            bTile[i] = int(floor(lhash(vec3(note, 54.0 + float(i), 8.1)) * float(BOLT_N))) % BOLT_N;
            float fl = flashEnvelope(since, BOLT_TAU[2]) * (0.6 + 0.4 * S(4).z);
            if (fl >= 0.01) {
                bool clear = true;
                for (int st = 1; st < 16 && clear; st++) {
                    vec3 x = mix(bA[i], bB[i], float(st) / 16.0);
                    for (int j = 1; j < N_RINGS; j++)
                        if (j > k && ringSD(transpose(gM[j]) * x, j) < 0.004) clear = false;
                }
                bFl[i] = clear ? fl : 0.0;
            }
        }
        if (bFl[i] < 0.01) bFl[i] = 0.0;
    }

}

