        if (dn <= 1e-4) continue;
        vec3 np = pw * SMK_NOISE_S - drift;
        float nz = 0.55 * vnoise(np) + 0.30 * vnoise(np * 2.03 + 7.1) + 0.15 * vnoise(np * 4.11 + 3.3);
        dn *= max(0.0, 1.0 + SMK_NOISE_K * (nz - 0.5) * 2.0 * 0.5);
