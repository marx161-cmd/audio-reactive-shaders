#ifdef K_LBLUR
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;
layout(rg16f, binding = 0) uniform writeonly image3D lbOut;
uniform sampler3D u_lbSrc;
uniform ivec3 u_lbAxis;
uniform float u_lbSig;
uniform int u_lbRad;
void main() {
    ivec3 p = cellId();
    if (outside(p)) return;
    vec2 acc = vec2(0.0);
    float ws = 0.0;
    for (int k = -u_lbRad; k <= u_lbRad; k++) {
        float w = exp(-float(k * k) / (2.0 * u_lbSig * u_lbSig));
        ws += w;
        ivec3 q = p + u_lbAxis * k;
        if (outside(q)) continue;
        acc += w * texelFetch(u_lbSrc, q, 0).xy;
    }
    imageStore(lbOut, p, vec4(acc / ws, 0.0, 0.0));
}
