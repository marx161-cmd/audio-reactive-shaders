            vec2 lt = LV_KN * texture(u_lvN, uvw).xy + LV_KW * texture(u_lvW, uvw).xy;
            if (lt.x > 1e-4) {
                float hT = 1.5 / float(LV_N_F);
                vec3 g = vec3(texture(u_lvW, uvw + vec3(hT, 0, 0)).x - texture(u_lvW, uvw - vec3(hT, 0, 0)).x,
                              texture(u_lvW, uvw + vec3(0, hT, 0)).x - texture(u_lvW, uvw - vec3(0, hT, 0)).x,
                              texture(u_lvW, uvw + vec3(0, 0, hT)).x - texture(u_lvW, uvw - vec3(0, 0, hT)).x);
                float gl = length(g), lwI = texture(u_lvW, uvw).x;
                vec3 sd = gl > 1e-7 ? g / gl : -rdW;
                float dirK = clamp(LV_DIR_K * gl / max(lwI, 1e-6), 0.0, 1.0);
                float sh = 0.0;
                for (int k = 1; k <= LV_SHADOW_N; k++) {
                    vec3 ps = pw + sd * (float(k) * LV_SHADOW_DS);
                    float dsn = texture(u_smk, toUVW(ps)).r;
                    dsn *= max(0.0, 1.0 + SMK_NOISE_K * (vnoise(ps * SMK_NOISE_S - drift) - 0.5));
                    sh += dsn;
                }
                float Tsh = exp(-SMOKE_SIGMA * SMK_SHADOW_K * sh * LV_SHADOW_DS);
                float cth = dot(sd, rdW);
                float gg = LV_HG_G * LV_HG_G;
                float hg = (1.0 - gg) / pow(1.0 + gg - 2.0 * LV_HG_G * cth, 1.5);
