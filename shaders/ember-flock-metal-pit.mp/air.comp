        Ls += Tacc * (1.0 - exp(-dTau)) * lit;
        Tacc *= exp(-dTau);
        tau += dTau;
    }
#if SMK_LV
    imageStore(outImg, q, vec4(tau, LsC));
#else
    imageStore(outImg, q, vec4(tau, Ls * vec3(1.0, 0.22, 0.04)));
#endif
}
