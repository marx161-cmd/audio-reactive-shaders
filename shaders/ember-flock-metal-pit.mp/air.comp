        }
        Tacc *= exp(-dTau);
        tau += dTau;
        continue;
#endif
        vec3 d0 = pw - F0.xyz, d1 = pw - F1.xyz;
        float l0 = exp(-dot(d0, d0) / (2.0 * w0 * w0)), l1 = exp(-dot(d1, d1) / (2.0 * w1 * w1));
        float lit = 0.0;
        {
            for (int f = 0; f < 2; f++) {
                float lf = (f == 0) ? l0 : l1;
                if (lf < 1e-3) continue;
                vec3 sd = normalize(((f == 0) ? F0.xyz : F1.xyz) - pw);
                float sh = 0.0;
                for (int k = 1; k <= SMK_SHADOW_N; k++) {
                    vec3 ps = pw + sd * (float(k) * SMK_SHADOW_DS);
                    float dsn = texture(u_smk, toUVW(ps)).r;
                    dsn *= max(0.0, 1.0 + SMK_NOISE_K * (vnoise(ps * SMK_NOISE_S - drift) - 0.5));
                    sh += dsn;
                }
                lit += lf * exp(-SMOKE_SIGMA * SMK_SHADOW_K * sh * SMK_SHADOW_DS);
