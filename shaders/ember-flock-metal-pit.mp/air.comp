                vec3 Lc = lv_bbLinear(T) * clamp(pow(T / LV_BB_T_REF, LV_BB_SB_EXP), LV_BB_L_MIN, LV_BB_L_MAX) * lt.x;
                LsC += Tacc * (1.0 - exp(-dTau)) * Lc * Tsh * mix(1.0, hg, dirK);
