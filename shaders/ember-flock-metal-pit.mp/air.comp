#define LV_FIX       1000.0
#ifdef K_LSPLAT
layout(local_size_x = 64) in;
layout(r32ui, binding = 0) uniform uimage3D lvU;
uniform sampler2D u_boid;
uniform sampler2D u_spk;
#define LV_EMB_W      1.00
#define LV_SPK_W      0.15
#define LV_SPK_N      16384
#define LV_HEAT_MIN   0.18
void splatL(vec3 x, float I, float heat) {
    if (I <= 1e-5) return;
    vec3 g = toUVW(x) * float(u_n) - 0.5;
    ivec3 b = ivec3(floor(g));
    vec3 f = g - vec3(b);
    for (int k = 0; k < 8; k++) {
        ivec3 o = ivec3(k & 1, (k >> 1) & 1, k >> 2);
        ivec3 c = b + o;
        if (outside(c)) continue;
        vec3 w3 = mix(1.0 - f, f, vec3(o));
        float w = w3.x * w3.y * w3.z * I;
        imageAtomicAdd(lvU, c, uint(w * LV_FIX + 0.5));
        imageAtomicAdd(lvU, c + ivec3(0, 0, u_n), uint(w * heat * LV_FIX + 0.5));
    }
}
void main() {
    int i = int(gl_GlobalInvocationID.x);
    if (i < N_ALL) {
        if (i % N_PER == 0) return;
        vec4 P = texelFetch(u_boid, ivec2(i, 0), 0), V = texelFetch(u_boid, ivec2(i, 1), 0), Lf = texelFetch(u_boid, ivec2(i, 2), 0);
        if (Lf.x <= 0.0) return;
        float fastE = smoothstep(0.90, 3.00, length(V.xyz));
        float seed = float(i) + V.w * 1000.0;
        float heat0 = 0.55 - 0.22 * (fract(seed * 0.3819660) - 0.35) * 2.0 + 0.10 * fract(seed * 0.7548776);
        heat0 = clamp(heat0 + 0.15 * fastE, 0.0, 1.0);
        splatL(P.xyz, LV_EMB_W * Lf.x * (1.0 + 0.35 * fastE), clamp(max(heat0, LV_HEAT_MIN) * Lf.y, 0.0, 1.0));
        return;
    }
    int j = i - N_ALL;
    if (j >= LV_SPK_N) return;
    vec4 P = texelFetch(u_spk, ivec2(j, 0), 0), V = texelFetch(u_spk, ivec2(j, 1), 0);
    if (V.w <= 0.0 || P.w >= V.w) return;
    float x = P.w / V.w;
    float fade = x < 0.55 ? 1.0 - 0.15 * x / 0.55 : 0.85 * (1.0 - (x - 0.55) / 0.45);
    float h1 = fract(float(j) * 0.6180339);
    float heat = clamp(mix(mix(0.50, 0.70, h1), 0.04, pow(x, 0.9)), 0.0, 1.0);
    splatL(P.xyz, LV_SPK_W * fade, heat);
}
#endif
#ifdef K_LRESOLVE
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;
layout(r32ui, binding = 0) uniform uimage3D lvU;
layout(rg16f, binding = 1) uniform writeonly image3D lvOut;
void main() {
    ivec3 p = cellId();
    if (outside(p)) return;
    ivec3 p2 = p + ivec3(0, 0, u_n);
    float I = float(imageLoad(lvU, p).r) / LV_FIX, IH = float(imageLoad(lvU, p2).r) / LV_FIX;
    imageStore(lvU, p, uvec4(0u));
    imageStore(lvU, p2, uvec4(0u));
    imageStore(lvOut, p, vec4(I, IH, 0.0, 0.0));
}
