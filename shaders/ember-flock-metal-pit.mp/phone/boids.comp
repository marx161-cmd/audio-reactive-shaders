        float s = 2.0 * u - 1.0;
        float span = rad * 1.95 * env;
        float flap = 0.22 * rad * sin(6.2831853 * beat / 2.0 - abs(s) * 1.6) * abs(s);
        float core = rad * 0.34 * env * exp(-3.5 * s * s) * sin(6.2831853 * v * 8.5);
        return vec3(s * span, flap + core, -len * (v * 0.75 + 0.25 * s * s));
