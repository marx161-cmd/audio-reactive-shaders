	} else {
		ids = int[10](SH_ARROW, SH_V, SH_CORK, SH_COMET, SH_FUNNEL, SH_STRIPE, SH_FB_WING, SH_FB_VIC, SH_FB_ECH, SH_FB_ASTERN);
