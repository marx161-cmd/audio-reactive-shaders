			vec3 ua = vec3(Cf(C_PINUX), Cf(C_PINUY), 0.0);
			vec3 rp = c3 + (cos(a) * ua + vec3(0.0, 0.0, sin(a))) * R;
			float pnW = smoothstep(0.0, 1.0, clamp(Cf(C_PENTW), 0.0, 1.0));
