#define SW_SEP_R1     0.060
#define SW_NB_R       0.25
#define SW_W_SEP      5.0
#define SW_W_ALIGN0   0.4
#define SW_W_ALIGN1   3.0
#define SW_W_COH0     0.20
#define SW_W_COH1     0.6
#define SW_W_TGT      2.5
#define SW_V_QUIET    0.30
#define SW_V_LOUD     0.85
#define SW_JIT_K      1.2
#define SW_ACCENT_SKIT 1.2
#define SW_ACCENT_K    0.35
#define SW_ACCENT_GATE 0.55
#define SW_ACCENT_VB   0.25
#define SW_CATCH_K    2.0
#define SW_CATCH_D0   0.08
#define SW_CATCH_D1   0.40
#define SW_GOAL_NEAR  0.45
#define SW_GOAL_D0    0.03
#define SW_GOAL_D1    0.20
#define SW_LEAD_SOFT  0.18
#define SW_LEAD_SPREAD 0.10
