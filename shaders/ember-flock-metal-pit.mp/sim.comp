    float rb = length(Pr);
    if (rb > BOUND_R) acc -= Pr / rb * (rb - BOUND_R) * SW_WALL_K;
    uint s = pcg(uint(i) * 9781u + uint(iFrame) * 6271u + 55u);
    acc += SW_JIT_K * Cv(C_HI) * (vec3(rnd(s), rnd(s), rnd(s)) - 0.5) * 2.0;
    acc += SW_ACCENT_SKIT * accS * (vec3(rnd(s), rnd(s), rnd(s)) - 0.5) * 2.0;
