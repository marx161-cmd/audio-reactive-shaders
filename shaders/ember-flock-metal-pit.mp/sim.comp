    vec3 dh = Pp - hk.xyz;
    float rh = length(dh);
    if (hk.w > 0.01 && rh < HAWK_R) acc += dh / max(rh, 1e-4) * (1.0 - rh / HAWK_R) * HAWK_K * hk.w;
