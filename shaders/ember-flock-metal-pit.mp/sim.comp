        float v = (0.317398726 + 4.22806245e-5 * T + 4.20481691e-8 * T * T) / (1.0 - 2.89741816e-5 * T + 1.61456053e-7 * T * T);
        float d = 2.0 * u - 8.0 * v + 4.0;
        return vec2(3.0 * u / d, 2.0 * v / d);
    }
    T = clamp(T, 1667.0, 25000.0);
    float t2 = T * T, t3 = t2 * T;
    float x = (T < 4000.0)
        ? (-0.2661239e9 / t3 - 0.2343589e6 / t2 + 0.8776956e3 / T + 0.179910)
        : (-3.0258469e9 / t3 + 2.1070379e6 / t2 + 0.2226347e3 / T + 0.240390);
    float y = (T < 2222.0)
        ? (-1.1063814 * x * x * x - 1.34811020 * x * x + 2.18555832 * x - 0.20219683)
        : ((T < 4000.0)
            ? (-0.9549476 * x * x * x - 1.37418593 * x * x + 2.09137015 * x - 0.16748867)
            : (3.0817580 * x * x * x - 5.87338670 * x * x + 3.75112997 * x - 0.37001483));
    return vec2(x, y);
}
vec3 blLinear(float T) {
    vec2 xy = blLocus(T);
    vec3 XYZ = vec3(xy.x / xy.y, 1.0, (1.0 - xy.x - xy.y) / xy.y);
    vec3 rgb = vec3( 3.2404542 * XYZ.x - 1.5371385 * XYZ.y - 0.4985314 * XYZ.z,
                    -0.9692660 * XYZ.x + 1.8760108 * XYZ.y + 0.0415560 * XYZ.z,
                     0.0556434 * XYZ.x - 0.2040259 * XYZ.y + 1.0572252 * XYZ.z);
    rgb = max(rgb, vec3(0.0));
    return rgb / max(max(rgb.r, max(rgb.g, rgb.b)), 1e-5);
}
vec3 blRad(uint Ir, uint Hr, float gain) {
    float I = float(Ir) / BL_FIX;
    if (I <= 0.0) return vec3(0.0);
    float heat = float(Hr) / BL_FIX / I;
    float T = BB_T_COLD + BB_T_SPAN * pow(clamp(heat, 0.0, 1.0), BB_HEAT_P);
    float L = clamp(pow(T / BB_T_REF, BB_SB_EXP), BB_L_MIN, BB_L_MAX);
#if DBG_LEAD_GREEN
    if (heat > DBG_LEAD_HEAT * 0.5) return vec3(0.0, 1.0, 0.0) * L * I * gain;
#endif
    return blLinear(T) * L * I * gain;
}
void main() {
    ivec2 o = ivec2(gl_GlobalInvocationID.xy);
    if (o.x >= u_size.x || o.y >= u_size.y) return;
    vec3 sum = vec3(0.0);
    for (int j = 0; j < 2; j++) for (int i = 0; i < 2; i++) {
        ivec2 p = min(o * 2 + ivec2(i, j), u_canvas - 1);
        sum += min(blRad(texelFetch(u_gI, p, 0).r, texelFetch(u_gH, p, 0).r, BL_EMB_GAIN), vec3(BL_CLAMP));
    }
    imageStore(bloomOut, o, vec4(sum * 0.25, 1.0));
}
#endif
#ifdef K_BLOOM_BLUR
uniform sampler2D u_src;
uniform ivec2 u_dir;
uniform float u_sigma;
void main() {
    ivec2 o = ivec2(gl_GlobalInvocationID.xy);
    if (o.x >= u_size.x || o.y >= u_size.y) return;
    int R = int(ceil(3.0 * u_sigma));
    vec3 acc = vec3(0.0);
    float wsum = 0.0;
    for (int k = -R; k <= R; k++) {
        float w = exp(-float(k * k) / (2.0 * u_sigma * u_sigma));
        ivec2 q = clamp(o + u_dir * k, ivec2(0), u_size - 1);
        acc += texelFetch(u_src, q, 0).rgb * w;
        wsum += w;
    }
    imageStore(bloomOut, o, vec4(acc / wsum, 1.0));
}
