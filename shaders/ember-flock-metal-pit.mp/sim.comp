            {
                vec3 c = camRot() * q;
                c.x *= SQUISH_X;
                c.z = -LASH_K * sqrt(c.z * c.z + FIG_MIRROR_K * FIG_MIRROR_K);
                {
                    float rc = length(c.xy);
