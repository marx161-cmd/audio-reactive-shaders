        coh += Q.xyz * g;
        cnt += g;
    }
    float wA = mix(SW_W_ALIGN0, SW_W_ALIGN1, smoothstep(0.15, 0.75, L)) * (0.75 + 0.35 * groove);
    float wC = mix(SW_W_COH0, SW_W_COH1, L) * mix(1.0, SW_STRAG_COH, strag);
