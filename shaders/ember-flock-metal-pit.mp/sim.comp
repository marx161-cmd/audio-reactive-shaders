#if FORM_FRAME
            if (FSEL < 0
                && C(C_TRNB) <= TURN_LEAD_BEATS
                && abs(C(C_TRNA)) > 0.45
                && mod(u_beat_count - C(C_SHT) + 1024.0, 1024.0) > MIN_HOLD_BEATS) {
