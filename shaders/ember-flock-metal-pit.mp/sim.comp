void edgeClamp(inout vec3 p, inout vec3 v) {
    mat3 R = camRot();
    vec3 c = R * (p - vec3(0.0, CAM_TY, 0.0));
    vec3 lo = vec3(-boxXW(u_edge), -boxYW(), BOX_ZN), hi = vec3(boxXW(u_edge), boxYW(), BOX_ZB);
    vec3 cl = clamp(c, lo, hi);
    if (cl == c) return;
    p = transpose(R) * cl + vec3(0.0, CAM_TY, 0.0);
    vec3 vc = R * v;
#ifdef K_BOIDS
    {
        float XW = boxXW(u_edge), YW = boxYW(), ZL = BOX_ZB - BOX_ZN;
        if (c.z > cl.z && vc.z > 0.0) stirHitAt(0, vec2((cl.x / XW + 1.0) * 0.5, (cl.y / YW + 1.0) * 0.5), vc.z);
        if (c.x != cl.x && vc.x * (c.x - cl.x) > 0.0) stirHitAt(c.x < 0.0 ? 1 : 2, vec2((cl.z - BOX_ZN) / ZL, (cl.y / YW + 1.0) * 0.5), abs(vc.x));
        if (c.y != cl.y && vc.y * (c.y - cl.y) > 0.0) stirHitAt(c.y < 0.0 ? 3 : 4, vec2((cl.x / XW + 1.0) * 0.5, (cl.z - BOX_ZN) / ZL), abs(vc.y));
    }
#endif
    if (c.x != cl.x && vc.x * (c.x - cl.x) > 0.0) vc.x = 0.0;
    if (c.y != cl.y && vc.y * (c.y - cl.y) > 0.0) vc.y = 0.0;
    if (c.z != cl.z && vc.z * (c.z - cl.z) > 0.0) vc.z = 0.0;
    v = transpose(R) * vc;
}
