    vec3 leadV = sv / max(sw2, 1e-6);
    float L = loudN(Cv(C_LOUD), Cv(C_LMAX));
    float groove = clamp(Cv(C_GROOVE), 0.0, 1.5);
    float sw = Cv(C_SPLITW);
    float sepR = mix(SW_SEP_R0, SW_SEP_R1, smoothstep(0.15, 0.75, L));
    uint hs = pcg(uint(i) * 40503u + 7u);
    float strag = float(rnd(hs) < SW_STRAG_SHARE);
