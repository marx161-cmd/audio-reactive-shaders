#ifdef K_SPARK
layout(local_size_x = 256) in;
layout(rgba32f, binding = 0) uniform image2D spkImg;
layout(r32ui,   binding = 1) uniform uimage2D waveHitImg;
uniform sampler2D u_boid;
uniform float iTime;
uniform float u_dt;
uniform float u_edge;
#define SPK_N        4096
#define SPK_RATE     8000.0
#define SPK_INHERIT  0.50
#define SPK_KICK     0.25
#define SPK_BIRTH_R  0.05
#define SPK_DRAG     0.50
#define SPK_GRAV     1.20
#define SPK_DOWN     vec3(0.0, 0.0, 1.0)
#define SPK_LIFE0    1.0
#define SPK_LIFE1    2.0
#define SPK_FLUTTER  0.20
void main() {
    int n = int(gl_GlobalInvocationID.x);
    if (n >= SPK_N) return;
    vec4 P = imageLoad(spkImg, ivec2(n, 0)), V = imageLoad(spkImg, ivec2(n, 1));
    if (V.w <= 0.0) { P.w = 1e9; V.w = 1.0; }
    float headF = mod(iTime * SPK_RATE, float(SPK_N));
    float rel = mod(float(n) - headF + float(SPK_N), float(SPK_N));
    if (rel < SPK_RATE * u_dt) {
        uint s = pcg(uint(n) * 2654435761u + uint(iTime * 1000.0) * 97u);
        int e = int(rnd(s) * float(N_ALL)) % N_ALL;
        if (e % N_PER == 0) e += 1;
        vec3 Lp = texelFetch(u_boid, ivec2(e, 0), 0).xyz, Lv = texelFetch(u_boid, ivec2(e, 1), 0).xyz;
        float alive = texelFetch(u_boid, ivec2(e, 2), 0).x;
        if (alive < 0.2) { imageStore(spkImg, ivec2(n, 0), vec4(P.xyz, 1e9)); imageStore(spkImg, ivec2(n, 1), V); return; }
        vec3 v = Lv * SPK_INHERIT + rndDir(s) * SPK_KICK * rnd(s);
        float life = mix(SPK_LIFE0, SPK_LIFE1, rnd(s));
        imageStore(spkImg, ivec2(n, 0), vec4(Lp + rndDir(s) * SPK_BIRTH_R * rnd(s), 0.0));
        imageStore(spkImg, ivec2(n, 1), vec4(v, life));
        return;
    }
    if (P.w >= V.w) { imageStore(spkImg, ivec2(n, 0), P); imageStore(spkImg, ivec2(n, 1), V); return; }
    vec3 v = V.xyz * exp(-SPK_DRAG * u_dt) + SPK_DOWN * (SPK_GRAV * u_dt);
    float fph = float(n) * 0.7548 + P.w * 3.0;
    v += SPK_FLUTTER * u_dt * vec3(sin(fph * 2.3 + iTime), 0.5 * sin(fph * 1.7 + 1.9 * iTime), cos(fph * 1.9 + 1.3 * iTime));
    vec3 lo = vec3(-boxXW(u_edge), -boxYW(), BOX_ZN), hi = vec3(boxXW(u_edge), boxYW(), BOX_ZB);
    vec3 nU = P.xyz + v * u_dt;
    vec3 nP = clamp(nU, lo, hi);
    if (nU != nP && all(lessThan(P.xyz, hi - 1e-4)) && all(greaterThan(P.xyz, lo + 1e-4))) {
        float XW = hi.x, YW = hi.y, ZL = BOX_ZB - BOX_ZN;
        int tile = -1; vec2 uv; float imp = 0.0;
        if (nU.z > hi.z)                  { tile = 0; uv = vec2((nP.x / XW + 1.0) * 0.5, (nP.y / YW + 1.0) * 0.5); imp = v.z; }
        else if (nU.x != nP.x)            { tile = nU.x < 0.0 ? 1 : 2; uv = vec2((nP.z - BOX_ZN) / ZL, (nP.y / YW + 1.0) * 0.5); imp = abs(v.x); }
        else if (nU.y != nP.y)            { tile = nU.y < 0.0 ? 3 : 4; uv = vec2((nP.x / XW + 1.0) * 0.5, (nP.z - BOX_ZN) / ZL); imp = abs(v.y); }
        if (tile >= 0 && imp > 1e-3) {
            ivec2 t = ivec2(clamp(uv, 0.0, 0.999) * 256.0) + ivec2(0, tile * 256);
            imageAtomicAdd(waveHitImg, t, uint(min(imp, 4.0) * 1000.0));
        }
    }
    imageStore(spkImg, ivec2(n, 0), vec4(nP, P.w + u_dt));
    imageStore(spkImg, ivec2(n, 1), vec4(v, V.w));
}
#endif

#ifdef K_SPLATSPK
layout(local_size_x = 64) in;
layout(r32ui, binding = 0) uniform uimage2D gI;
layout(r32ui, binding = 1) uniform uimage2D gH;
layout(rgba32f, binding = 2) uniform readonly image2D spkImg;
uniform ivec2 u_canvas;
#define SPK_N     4096
#ifndef FIX
#define FIX       1024.0
#endif
#define SPK_W     0.0035
#define SPK_GAIN  1.9
#define SPK_HOLD  0.55
#define SPK_FADE  1.0
#define SPK_BORN0 0.50
#define SPK_BORN1 0.70
#define SPK_COOL_EX 0.9
#define SPK_ASH   0.35
void main() {
    int i = int(gl_GlobalInvocationID.x);
    if (i >= SPK_N) return;
    vec4 P = imageLoad(spkImg, ivec2(i, 0)), V = imageLoad(spkImg, ivec2(i, 1));
    if (V.w <= 0.0 || P.w >= V.w) return;
    float x = P.w / V.w;
    float fade = x < SPK_HOLD ? 1.0 - 0.15 * x / SPK_HOLD : 0.85 * pow(1.0 - (x - SPK_HOLD) / (1.0 - SPK_HOLD), SPK_FADE);
    float h1 = fract(float(i) * 0.6180339), h2 = fract(float(i) * 0.7548777);
    float ash = smoothstep(1.0 - SPK_ASH, 1.0, x);
    float size = mix(0.7, 1.5, h2 * h2 * h2);
    vec3 a = lensP(P.xyz, 0);
    if (a.z < 0.0) return;
    float H = float(u_canvas.y);
    vec2 pa = (a.xy * H + vec2(u_canvas)) * 0.5;
    float w = max(SPK_W * a.z * H * 0.5 * size * (1.0 - 0.35 * ash), 0.6);
    float heat = clamp(mix(mix(SPK_BORN0, SPK_BORN1, h1), 0.04, pow(x, SPK_COOL_EX)), 0.0, 1.0);
    float b = SPK_GAIN * fade * mix(0.8, 1.0, size / 1.5);
    int R = int(ceil(min(3.0 * w, 9.0)));
    ivec2 cp = ivec2(floor(pa));
    for (int y = -R; y <= R; y++) for (int x2 = -R; x2 <= R; x2++) {
        ivec2 q = cp + ivec2(x2, y);
        if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, u_canvas))) continue;
        float d = length(vec2(q) + 0.5 - pa);
        float I = b * exp(-(d / w) * (d / w));
        uint add = uint(I * FIX + 0.5);
        if (add == 0u) continue;
        imageAtomicAdd(gI, q, add);
        imageAtomicAdd(gH, q, uint(I * heat * FIX + 0.5));
    }
}
#endif

#ifdef K_WAVE
layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba32f, binding = 0) uniform readonly image2D waveIn;
layout(rgba32f, binding = 1) uniform writeonly image2D waveOut;
layout(r32ui,   binding = 2) uniform uimage2D waveHitImg;
uniform sampler2D u_stir;
uniform float u_dt;
uniform int u_wsub;
#define WAVE_T       256
#define WAVE_C       110.0
#define WAVE_NU      12.0
#define WAVE_TAU     0.8
#define WAVE_LEVEL   0.35
#define WAVE_PUSH    30.0
#define WAVE_SPK_K   0.25
#define WAVE_SIG     2.2
#define WAVE_HMAX    0.25
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(waveIn);
    if (p.x >= sz.x || p.y >= sz.y) return;
    int y0 = (p.y / WAVE_T) * WAVE_T, y1 = y0 + WAVE_T - 1;
    vec4 c = imageLoad(waveIn, p);
    vec4 l = imageLoad(waveIn, ivec2(max(p.x - 1, 0), p.y)), r = imageLoad(waveIn, ivec2(min(p.x + 1, sz.x - 1), p.y));
    vec4 d = imageLoad(waveIn, ivec2(p.x, max(p.y - 1, y0))), u = imageLoad(waveIn, ivec2(p.x, min(p.y + 1, y1)));
    vec2 lap = (l + r + d + u - 4.0 * c).xy;
    float h = c.x, v = c.y;
    v += u_dt * (WAVE_C * WAVE_C * lap.x + WAVE_NU * lap.y);
    v *= exp(-u_dt / WAVE_TAU);
    if (u_wsub == 0) {
        float f = 0.0, ws = 0.0;
        for (int j = -3; j <= 3; j++) for (int i = -3; i <= 3; i++) {
            float w = exp(-float(i * i + j * j) / (2.0 * WAVE_SIG * WAVE_SIG));
            ws += w;
            ivec2 q = p + ivec2(i, j);
            if (q.x < 0 || q.x >= sz.x || q.y < y0 || q.y > y1) continue;
            f += w * (texelFetch(u_stir, q, 0).z + WAVE_SPK_K * float(imageLoad(waveHitImg, q).r) / 1000.0);
        }
        v -= WAVE_PUSH * f / ws;
    }
    if (u_wsub == 1) imageStore(waveHitImg, p, uvec4(0u));
    h += u_dt * v;
    h *= exp(-u_dt / WAVE_LEVEL);
    if (!(h == h) || !(v == v)) { h = 0.0; v = 0.0; }
    imageStore(waveOut, p, vec4(clamp(h, -WAVE_HMAX, WAVE_HMAX), v, 0.0, 1.0));
}
