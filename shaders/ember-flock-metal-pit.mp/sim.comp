int pickBody(float tight, float fast, int cur, float salt) {
    float straight = 1.0 - tight, mid = 1.0 - abs(2.0 * tight - 1.0), calm = 1.0 - fast;
    float sc[16] = float[16](fast * straight,
                             fast * straight * 0.8,
                             fast * mid,
                             0.5,
                             calm * straight * 0.85,
                             tight * (1.0 - 0.5 * fast),
                             calm * 0.7,
                             0.5,
                             fast * mid * 0.9,
                             calm * 0.7,
                             -1e9,
                             fast * straight * 1.1,
                             fast * mid,
                             tight,
                             calm * 0.9,
                             calm * straight);
    int best = 0; float bs = -1e9;
    for (int n = 0; n < 16; n++) {
        if (n == 10) continue;
#if BODY_NO_WEAVES
        if (n == 2 || n == 3 || (n >= 6 && n <= 9)) continue;
#endif
        float v = sc[n] + 0.35 * hash11(salt * 7.0 + float(n)) - (n == cur ? 0.6 : 0.0);
        if (v > bs) { bs = v; best = n; }
    }
    return best;
}
