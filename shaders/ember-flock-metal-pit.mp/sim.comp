    int Rr = int(ceil(Lc)) + 4 + int(ceil(3.2 * max(DT_GLOW_W * Wm, 1.7)));
    ivec2 c = ivec2(floor(pa));
    for (int y = -Rr; y <= Rr; y++) for (int x = -Rr; x <= Rr; x++) {
        ivec2 q = c + ivec2(x, y);
        if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, u_canvas))) continue;
        vec2 dp = vec2(q) + 0.5 - pa;
        float sx = dot(dp, dir);
#if DT_TAIL
        float t = (sx + 0.86 * Lc) / Lc;
#else
        float t = (sx + 0.50 * Lc) / Lc;
#endif
        float mg = 3.2 * max(DT_GLOW_W * Wm, 1.7) / Lc;
