    if (cnt > 0.0) acc += wA * (ali / cnt - Vv) + wC * (coh / cnt - Pp);
    vec3 T = leadP;
    if (sw > 0.0) {
        vec3 tn = dot(leadV, leadV) > 1e-8 ? normalize(leadV) : vec3(1.0, 0.0, 0.0);
        vec3 side = normalize(cross(tn, abs(tn.y) < 0.95 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0)));
        T += side * SPLIT_D * sw * (Pw < 0.5 ? -1.0 : 1.0);
    }
    float vT = max(max(mix(SW_V_QUIET, SW_V_LOUD, smoothstep(0.1, 0.8, L)), 1.1 * length(headV)), 1.1 * length(leadV) * SW_LEAD_FOLLOW) * drop;
