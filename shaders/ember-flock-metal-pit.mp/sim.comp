    float sep = L_SEP0 + L_SEP1 * pow(sin(t * 0.5), 4.0) + L_KICK_SEP * sepX.x;
    sep += SPONGE_PUSH * sepX.y;
    sep *= 1.0 - WINDUP_K * sepX.z;
    float rose = 1.0 - pocket * (0.5 - 0.5 * cos(spin * 3.0));
    vec3 offA = vec3(cos(spin) * sep, sin(spin * 1.5) * L_BOB, sin(spin) * sep);
    vec3 offB = vec3(cos(spin) * sep, sin(spin) * L_BOB, sin(2.0 * spin) * 0.5 * sep);
    float rr = sep * (1.0 - 0.6 * (0.5 - 0.5 * cos(3.0 * spin)));
