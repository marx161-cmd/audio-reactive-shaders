            s0 *= figAmp;
            wp0 = baseP + transpose(camRot()) * s0;
            dbgS0 = length(s0);
            float rushT = C(W_RUSHT);
            if (u_ms_change != C(W_RUSHSEE)) {
                W(W_RUSHSEE, u_ms_change);
                if (SCATTER_ON != 0 && max(u_ms_sec_b.w, u_ms_cur_b.w) > SCATTER_HEAVY) {
