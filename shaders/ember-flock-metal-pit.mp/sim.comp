#ifdef K_DART
layout(r32ui, binding = 2) uniform uimage2D gR;
float sdTri(vec2 p, vec2 a, vec2 b, vec2 c) {
    vec2 e0 = b - a, e1 = c - b, e2 = a - c;
    vec2 v0 = p - a, v1 = p - b, v2 = p - c;
    vec2 pq0 = v0 - e0 * clamp(dot(v0, e0) / dot(e0, e0), 0.0, 1.0);
    vec2 pq1 = v1 - e1 * clamp(dot(v1, e1) / dot(e1, e1), 0.0, 1.0);
    vec2 pq2 = v2 - e2 * clamp(dot(v2, e2) / dot(e2, e2), 0.0, 1.0);
    float s = sign(e0.x * e2.y - e0.y * e2.x);
    vec2 d = min(min(vec2(dot(pq0, pq0), s * (v0.x * e0.y - v0.y * e0.x)),
                     vec2(dot(pq1, pq1), s * (v1.x * e1.y - v1.y * e1.x))),
                 vec2(dot(pq2, pq2), s * (v2.x * e2.y - v2.y * e2.x)));
    return -sqrt(d.x) * sign(d.y);
}
void main() {
    int e = int(gl_GlobalInvocationID.x);
    if (e >= 2 * N_ALL) return;
    bool refl = e >= N_ALL;
    int i = refl ? e - N_ALL : e;
    if (i % N_PER == 0) return;
    vec4 P = texelFetch(u_boid, ivec2(i, 0), 0), V = texelFetch(u_boid, ivec2(i, 1), 0);
    vec4 Lf = texelFetch(u_boid, ivec2(i, 2), 0);
#if DBG_LEAD_GREEN
    bool dbgLead = (i % LEAD_STRIDE) == 0;
#endif
    mat3 R = camRot();
    float gainR = refl ? LNS_GAIN2 : 1.0;
    float H = float(u_canvas.y);
    vec3 a = lensP(P.xyz, refl ? 1 : 0);
    vec3 a2 = lensP(P.xyz + V.xyz * 0.03, refl ? 1 : 0);
    if (a.z < 0.0 || a2.z < 0.0) return;
    vec2 pa = (a.xy * H + vec2(u_canvas)) * 0.5;
    vec2 sv = (a2.xy - a.xy) * H * 0.5;
    float spd = length(sv);
    vec2 dir = spd > 1e-3 ? sv / spd : vec2(0.0, 1.0);
    float fastE = smoothstep(TR_FLARE_V0, TR_FLARE_V1, length(V.xyz));
    float w = TR_EMB_W * a.z * H * 0.5;
    float h1 = fract(float(i) * 0.6180339), h2 = fract(float(i) * 0.7548777), h3 = fract(float(i) * 0.5698403);
    float Lc = max(DT_L * w * 1.2, DT_MINL * 1.35) * mix(0.65, 1.40, h1) * (1.0 + 0.45 * fastE);
#if !DT_TAIL
    Lc = max(DT_L * w * 0.75, 3.4) * mix(0.8, 1.25, h1);
