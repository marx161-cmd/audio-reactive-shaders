vec3 rotAx(vec3 v, vec3 a, float c, float s) {
    return v * c + cross(a, v) * s + a * dot(a, v) * (1.0 - c);
}
#define MOVE_K      0.45
#define MOVE_YK     1.00
vec3 mover(int f, float one) {
    if (u_pad_alive < 0.5) return vec3(0.0);
    vec2 s = (f == 0) ? u_pad_e_tilt : u_pad_e_skew;
    return vec3(s.x * MOVE_K, s.y * MOVE_YK, 0.0) * (1.0 - clamp(2.0 * one, 0.0, 1.0));
}
vec3 padPlane(vec3 off, int f, float one) {
    if (u_pad_alive < 0.5) return off;
    float a = clamp(2.0 * one, 0.0, 1.0);
    float b = clamp(2.0 * one - 1.0, 0.0, 1.0);
    vec2 axis = mix((f == 0) ? u_pad_e_tilt : u_pad_e_skew, u_pad_e_tilt, b) * a;
    float tl = min(length(axis), 1.0);
    if (tl > 0.001) {
        vec2 ta = axis / max(length(axis), 1e-6);
        float ang = tl * 1.5707963;
        off = rotAx(off, normalize(vec3(-ta.y, 0.0, ta.x)), cos(ang), sin(ang));
    }
    vec2 st = u_pad_e_skew * b;
    float dl = min(length(st), 1.0);
    if (dl > 0.001) {
        vec2 da = st / max(length(st), 1e-6);
        vec3 dir = vec3(da.x, 0.0, da.y);
        off += dir * (dot(off, dir) * dl * 0.9);
