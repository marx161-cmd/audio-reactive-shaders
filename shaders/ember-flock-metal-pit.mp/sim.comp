#ifdef K_TRAIL
void main() {
    uint gid = gl_GlobalInvocationID.x;
    int seg = int(gid % uint(HIST_N - 1));
    int e = int(gid / uint(HIST_N - 1));
    if (e >= 2 * N_ALL) return;
    bool refl = e >= N_ALL;
    int i = refl ? e - N_ALL : e;
    if (i % N_PER == 0) return;
    vec4 Lf = texelFetch(u_boid, ivec2(i, 2), 0);
#if DBG_LEAD_GREEN
    bool dbgLead = (i % LEAD_STRIDE) == 0;
#endif
    float tir = clamp(Lf.z / max(Lf.w, 1e-3), 0.0, 1.0);
    float llen = mix(1.0, TR_DEAD_LEN, tir);
    float bpm = u_beat_bpm > 30.0 ? u_beat_bpm : 120.0;
    float trailT = clamp(TRAIL_BEATS * llen * 60.0 / bpm, 0.06, 0.9 * llen);
    vec4 H0 = histAt(i, 0);
    trailT = min(trailT, TR_MAXLEN * llen / max(length(texelFetch(u_boid, ivec2(i, 1), 0).xyz), 0.05));
    vec4 A = histAt(i, seg), B = histAt(i, seg + 1);
    if (H0.w <= 0.0 || A.w <= 0.0 || B.w <= 0.0 || A.w <= B.w) return;
    float ageA = (H0.w - A.w) / trailT, ageB = (H0.w - B.w) / trailT;
    if (ageA >= 1.0) return;
    if (A.w - B.w > 0.25 || distance(A.xyz, B.xyz) > 0.7) return;
    vec3 Cp = seg + 2 < HIST_N ? histAt(i, seg + 2).xyz : B.xyz - (A.xyz - B.xyz);
    vec3 Dp = seg > 0 ? histAt(i, seg - 1).xyz : A.xyz + (A.xyz - B.xyz);
    if (seg + 2 < HIST_N && (histAt(i, seg + 2).w <= 0.0 || distance(Cp, B.xyz) > 0.7)) Cp = B.xyz - (A.xyz - B.xyz);
    if (seg > 0 && (histAt(i, seg - 1).w <= 0.0 || distance(Dp, A.xyz) > 0.7)) Dp = A.xyz + (A.xyz - B.xyz);
    vec4 P = texelFetch(u_boid, ivec2(i, 0), 0), V = texelFetch(u_boid, ivec2(i, 1), 0);
    float fastE = smoothstep(TR_FLARE_V0, TR_FLARE_V1, length(V.xyz));
    float heat0 = emberHeat0(i, V.w, fastE);
    mat3 R = camRot();
    float H = float(u_canvas.y);
    float gainR = refl ? LNS_GAIN2 : 1.0;
    vec2 prevPx = vec2(0.0);
    bool havePrev = false;
    for (int j = 0; j <= TR_SUB; j++) {
        float u = float(j) / float(TR_SUB);
        vec3 pw = 0.5 * ((2.0 * B.xyz) + (-Cp + A.xyz) * u + (2.0 * Cp - 5.0 * B.xyz + 4.0 * A.xyz - Dp) * u * u + (-Cp + 3.0 * B.xyz - 3.0 * A.xyz + Dp) * u * u * u);
        float age = mix(ageB, ageA, u);
        if (age >= 1.0) { havePrev = false; continue; }
        vec3 a = lensP(pw, refl ? 1 : 0);
        if (a.z < 0.0) { havePrev = false; continue; }
        vec2 px = (a.xy * H + vec2(u_canvas)) * 0.5;
        if (havePrev) {
            float len = length(px - prevPx);
            int steps = int(clamp(ceil(len * 2.0), 1.0, 220.0));
            float ageP = mix(ageB, ageA, float(j - 1) / float(TR_SUB));
            for (int s = 0; s < steps; s++) {
                float t = (float(s) + 0.5) / float(steps);
                float ag = mix(ageP, age, t);
                if (ag >= 1.0) continue;
                float f = pow(1.0 - ag, TR_FALL);
                float I = TR_I * f * (1.0 + TR_FLARE_I * fastE) * gainR * (len / float(steps)) * mix(Lf.x, TR_DEAD_I, tir);
                float heat = clamp((TR_STREAK_H + TR_TAIL_WHITE * ag + TR_FLARE_H * fastE) * Lf.y, 0.0, 1.0);
