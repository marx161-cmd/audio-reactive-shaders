            if (swB > 3.5 && swB < 7.5) sm = 1.0;
            vec3 s0 = mix(swimSlot(int(swA + 0.5), figPhase, 0.0, u_beat_count), swimSlot(int(swB + 0.5), figPhase, 0.0, u_beat_count), sm);
            {
                vec3  tn  = vec3(cos(figBlade), sin(figBlade), 0.0);
                float tce = cos(figEdge), tse = sin(figEdge);
