#ifdef K_ADAPT
layout(local_size_x = 64) in;
layout(rgba32f, binding = 0) uniform image2D histImg;
layout(r32i,    binding = 1) uniform iimage3D stirImg;
layout(r32ui,   binding = 2) uniform uimage2D stirHitImg;
layout(rgba32f, binding = 3) uniform image2D flkImg;
layout(r32f,    binding = 4) uniform image2D ctlImg;
uniform sampler2D u_boid;
uniform sampler2D u_boidP;
uniform sampler2D u_pflk;
uniform sampler2D u_pctl;
uniform int u_pacc;
uniform int u_hrow;
uniform float u_edge;
uniform float iTime;
#define AD_STIR_T   256
#define AD_FIX_W    1000.0
#define AD_HIT_MAX  4.0
#define AD_C_ACCENT 37
void adHit(int tile, vec2 uv, float imp) {
    if (imp < 1e-3) return;
    ivec2 t = ivec2(clamp(uv, 0.0, 0.999) * float(AD_STIR_T)) + ivec2(0, tile * AD_STIR_T);
    imageAtomicAdd(stirHitImg, t, uint(min(imp, AD_HIT_MAX) * AD_FIX_W));
}
void main() {
    int i = int(gl_GlobalInvocationID.x);
    if (i == 0) {
        for (int k = 0; k < 12; k++)
            imageStore(flkImg, ivec2(k, 0), vec4(texelFetch(u_pflk, ivec2(4 * k, 0), 0).r, texelFetch(u_pflk, ivec2(4 * k + 1, 0), 0).r,
                                                 texelFetch(u_pflk, ivec2(4 * k + 2, 0), 0).r, texelFetch(u_pflk, ivec2(4 * k + 3, 0), 0).r));
        imageStore(ctlImg, ivec2(AD_C_ACCENT, 0), vec4(texelFetch(u_pctl, ivec2(u_pacc, 0), 0).r));
    }
    if (i >= N_ALL) return;
    vec4 P = texelFetch(u_boid, ivec2(i, 0), 0), V = texelFetch(u_boid, ivec2(i, 1), 0), Lf = texelFetch(u_boid, ivec2(i, 2), 0);
    vec3 nP = P.xyz, v = V.xyz;
    if (!(dot(nP, nP) < 1e30)) return;
    imageStore(histImg, ivec2(i, u_hrow), vec4(nP, iTime));
    {
        vec3 v0 = texelFetch(u_boidP, ivec2(i, 1), 0).xyz;
        float XW = boxXW(u_edge), YW = boxYW(), ZL = BOX_ZB - BOX_ZN, e = 1e-3;
        if (nP.z >= BOX_ZB - e && v0.z > 0.0) adHit(0, vec2((nP.x / XW + 1.0) * 0.5, (nP.y / YW + 1.0) * 0.5), v0.z);
        if (abs(nP.x) >= XW - e && v0.x * nP.x > 0.0) adHit(nP.x < 0.0 ? 1 : 2, vec2((nP.z - BOX_ZN) / ZL, (nP.y / YW + 1.0) * 0.5), abs(v0.x));
        if (abs(nP.y) >= YW - e && v0.y * nP.y > 0.0) adHit(nP.y < 0.0 ? 3 : 4, vec2((nP.x / XW + 1.0) * 0.5, (nP.z - BOX_ZN) / ZL), abs(v0.y));
    }
    float lifeTired = Lf.w > 0.0 ? clamp(Lf.z / Lf.w, 0.0, 1.0) : 0.0;
    float smokeE = SMOKE_E_ALL + (1.0 - SMOKE_E_ALL) * lifeTired * lifeTired;
    {
        vec3 g = (nP / (2.0 * AIR_H) + 0.5) * float(STIR_N_F) - 0.5;
        ivec3 g0 = ivec3(floor(g));
        vec3 fr = g - vec3(g0);
        for (int c = 0; c < 8; c++) {
            ivec3 o = ivec3(c & 1, (c >> 1) & 1, c >> 2);
            ivec3 q = g0 + o;
            if (any(lessThan(q, ivec3(0))) || any(greaterThanEqual(q, ivec3(STIR_N_F)))) continue;
            vec3 w3 = mix(1.0 - fr, fr, vec3(o));
            float w = w3.x * w3.y * w3.z;
            imageAtomicAdd(stirImg, q, int(v.x * w * STIR_FIX_F));
            imageAtomicAdd(stirImg, q + ivec3(0, 0, STIR_N_F), int(v.y * w * STIR_FIX_F));
            imageAtomicAdd(stirImg, q + ivec3(0, 0, 2 * STIR_N_F), int(v.z * w * STIR_FIX_F));
            imageAtomicAdd(stirImg, q + ivec3(0, 0, 3 * STIR_N_F), int(w * STIR_FIX_F));
            imageAtomicAdd(stirImg, q + ivec3(0, 0, 4 * STIR_N_F), int(w * smokeE * STIR_FIX_F));
        }
    }
}
#endif
