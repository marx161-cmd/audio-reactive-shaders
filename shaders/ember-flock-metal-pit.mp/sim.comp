    }
    if (m < N_LEAD && fc >= uint(FOL_MIN_E)) {
        float expect = float(FOL_N) / float(max(nAct, 1));
        float share = clamp(float(fc) / max(expect, 1e-3), 0.0, 1.0);
        float social = min(u_social * (1.0 + SOCIAL_SPARSE_K * (1.0 - share)), SOCIAL_MAX);
