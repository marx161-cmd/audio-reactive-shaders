void swarmStep(int i, int f, vec3 Pp, float Pw, vec3 Vv, vec3 headV, float drop, out vec3 nPs, out vec3 vs) {
    int nAct = nLeaders(Cv(C_SPLV));
    vec3 sp = vec3(0.0), sv = vec3(0.0);
    float sw2 = 0.0, best = 1e9;
    for (int k = 0; k < nAct; k++) {
        vec3 dk = texelFetch(u_ldr, ivec2(k, 2 * f), 0).xyz - Pp;
        best = min(best, dot(dk, dk));
    }
    for (int k = 0; k < nAct; k++) {
        vec3 lp = texelFetch(u_ldr, ivec2(k, 2 * f), 0).xyz;
        vec3 d = lp - Pp;
        float w = exp(-(dot(d, d) - best) / (SW_LEAD_SOFT * SW_LEAD_SOFT));
        if (w < 0.01) continue;
