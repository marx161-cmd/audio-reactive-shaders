        float press = C(C_PRESS);
        press += (1.0 - smoothstep(SPONGE_NEAR, SPONGE_FAR, sep0) - press) * (1.0 - exp(-dBeats / SPONGE_BEATS));
        W(C_PRESS, press);
        hW = NO_CIRCLE ? vec4(0.0, wA + wB, wC, wD) : vec4(wA, wB, wC, wD);
        vec3 wp0;
        float dbgFig = 0.0, dbgB = 0.0, dbgS0 = 0.0;
        {
            bool kickOnset = u_kick > pushPrev + HAWK_KICK;
            float hawk = kickOnset ? HAWK_TAU : max(0.0, C(W_HAWK) - dt);
            if (u_pad_alive > 0.5 && u_pad_e_fly.y > 0.5) hawk = HAWK_TAU;
            W(W_HAWK, hawk);
            float hawkAmt = smoothstep(0.0, HAWK_TAU, hawk);
            float pdir = C(W_PDIR) < 0.0 ? -1.0 : 1.0;
            float wscat = C(W_SCAT), sseen = C(W_SSEEN);
            if (u_ms_change != sseen) {
                W(W_SSEEN, u_ms_change);
                if (SCATTER_ON == 0) { }
                else if (max(u_ms_sec_b.w, u_ms_cur_b.w) > SCATTER_HEAVY) { pdir = -pdir; wscat = SCATTER_BEATS; }
                else if (max(u_ms_sec_b.w, u_ms_cur_b.w) > SCATTER_IMPACT) wscat = max(wscat, BURST_BEATS);
            }
            float wspd = 1.0 + SCATTER_SPD * smoothstep(0.0, SCATTER_BEATS, wscat) + HAWK_SPD * hawkAmt;
#if SCATTER_ON
            float pb = C(W_PB) + pdir * wspd * dBeats;
#else
            float pbx = (C(W_PBX) + (wspd - 1.0) * dBeats) * exp(-dBeats / 4.0);
            W(W_PBX, pbx);
            float pb = u_beat_count - barOff + pbx;
#endif
            W(W_PB, pb); W(W_PDIR, pdir); W(W_SCAT, max(0.0, wscat - dBeats));
            float tiltT = C(W_TILTT), tiltN = C(W_TILTN);
            if (u_ms_change != C(W_TSEEN)) {
                W(W_TSEEN, u_ms_change);
                if (max(u_ms_sec_b.w, u_ms_cur_b.w) > TILT_IMPACT) { tiltT = TILT_BEATS; tiltN += 1.0; W(W_TILTN, tiltN); }
            }
            W(W_TILTT, max(0.0, tiltT - dBeats));
            float te = TILT_BEATS - tiltT;
            float tenv = tiltT > 0.0 ? smoothstep(0.0, 1.0, te) * (1.0 - smoothstep(TILT_BEATS - 2.0, TILT_BEATS, te)) : 0.0;
            float tiltPose = mod(tiltN - 1.0, 4.0);
            float figEdge, figBlade;
            if      (tiltPose < 0.5) { figEdge =  TILT_DEG;  figBlade = 0.0; }
            else if (tiltPose < 1.5) { figEdge = -TILT_DEG;  figBlade = 0.0; }
            else if (tiltPose < 2.5) { figEdge =  FIG_EDGE1; figBlade = 0.0; }
            else                     { figEdge =  FIG_EDGE1; figBlade = FIG_EDGE1; }
            figEdge *= tenv * mH;
            W(W_TEDGE, figEdge); W(W_TBLADE, figBlade);
            float lane  = mod(floor(pb / FIG_LANE_BEATS), FIG_LANE_N);
            float laneZ = (lane - 0.5 * (FIG_LANE_N - 1.0)) * FIG_LANE_DZ;
            float wloud = clamp(0.5 * u_ms_cur_a.x + 0.5 * push, 0.0, 1.0);
#if HEAD_FLIGHT
            vec3 fig = headFly(dt, dBeats, wloud);
#else
            float pbW = pb;
            {
                float ppS = (ORBIT_BEATS / ORBIT_SPEED) / 3.0;
                float uS = fract(pb / ppS);
                float kS = POCKET_SKEW * clamp(hW.x + hW.y + hW.z, 0.0, 1.0);
                pbW = ppS * (floor(pb / ppS) + uS - kS / 6.2831853 * sin(6.2831853 * uS));
            }
            vec3 fig = wHeadOffAt(pbW * ORBIT_SPEED, hW, hWE, hPocket, vec3(push, press, windup), 0.0, 0.0, 1.0, laneZ, wloud);
            {
                float pp = (ORBIT_BEATS / ORBIT_SPEED) / 3.0;
                float nP = (floor(pb / pp - 0.5) + 1.5) * pp;
                float hh = 0.5 * pp;
                vec3 a0p = wHeadOffAt((nP - hh) * ORBIT_SPEED, hW, hWE, hPocket, vec3(push, press, windup), 0.0, 0.0, 1.0, laneZ, wloud);
                vec3 a1p = wHeadOffAt(nP * ORBIT_SPEED,        hW, hWE, hPocket, vec3(push, press, windup), 0.0, 0.0, 1.0, laneZ, wloud);
                vec3 a2p = wHeadOffAt((nP + hh) * ORBIT_SPEED, hW, hWE, hPocket, vec3(push, press, windup), 0.0, 0.0, 1.0, laneZ, wloud);
                vec3 t1 = normalize(a1p - a0p + 1e-6), t2 = normalize(a2p - a1p + 1e-6);
                vec3 camF = camRot() * vec3(0.0, 0.0, 1.0);
                float ang = acos(clamp(dot(t1, t2), -1.0, 1.0)) * (dot(cross(t1, t2), camF) < 0.0 ? -1.0 : 1.0);
                W(C_TRNB, nP - pb); W(C_TRNA, ang);
#if TILT_ON
                {
                    float pIdx = floor(pb / pp - 0.5);
                    float tA = C(C_TLT_A), tT = C(C_TLT_T), tEnd = C(C_TLT_END), tTh = C(C_TLT_TH);
                    if (tEnd > pb + 64.0 || tEnd < pb - 1024.0) { tEnd = 0.0; tT = 0.0; }
                    if (pIdx != C(C_TLT_LP)) {
                        W(C_TLT_LP, pIdx);
                        if (pb >= tEnd && abs(tA) < 0.05) {
                            vec3 fN = wHeadOffAt((pb + 0.125) * ORBIT_SPEED, hW, hWE, hPocket, vec3(push, press, windup), 0.0, 0.0, 1.0, laneZ, wloud);
                            vec3 dC = camRot() * (fN - fig);
                            float thT = atan(dC.y, dC.x + 1e-6);
                            float r1 = hash11(pIdx * 5.31 + 0.7), r2 = hash11(pIdx * 9.17 + 0.3);
