    if (gBraid) { kp = k / 3; nPt = N_LEAD / 3; }
    float v = (float(kp) + 0.5) / float(nPt);
    float u = fract(float(kp) * 0.61803398875);
    float len = FS_LEN * famp * cz;
    float rad = FS_RAD * famp / sqrt(max(cz, 0.4));
    vec3 o = shapeLocal(sel, u, v, len, rad, beat, reord);
    int role = kp % FS_FILL_DIV;
    float fill = (role == 0) ? FS_CORE_K : ((role == 1) ? FS_INNER_K : 1.0);
    if (sel >= 11) { o = flightFormLocal(sel, kp, nPt, famp); fill = 1.0; }
#if FS_BRAIDSETS == 2
    {
        int nS = FS_SETS * 3;
        int setI = k % FS_SETS, strand = (k / FS_SETS) % 3, along = k / nS;
        float nAl = ceil(float(N_LEAD) / float(nS));
        float vv = (float(along) + 0.5) / nAl;
        float phs = 6.2831853 * (float(strand) / 3.0 + FS_BR_TURNS * vv + FS_BR_SPIN * beat);
        float rr = FS_BR_RAD * famp;
        o = vec3((float(setI) - 0.5 * float(FS_SETS - 1)) * FS_SET_GAP + rr * 1.2 * sin(phs),
                 rr * 0.7 * sin(2.0 * phs), -len * vv);
        fill = 1.0;
    }
#endif
    vec2 plait = vec2(0.0);
    if (gBraid) {
        float phs = 6.2831853 * (float(strand) / 3.0 + FS_BR_TURNS * v + FS_BR_SPIN * beat);
        plait = BRL_RAD * famp * vec2(1.2 * sin(phs), 0.7 * sin(2.0 * phs));
    }
    vec2 oc = (o.xy * fill + plait) * vec2(1.0, FS_FLAT);
    float sTarget = a0 + o.z;
    int n = 0;
    while (n < PRED_N - 2 && sArc[n + 1] < sTarget) n++;
    float segL = max(sArc[n + 1] - sArc[n], 1e-6);
    vec3 T = (sPts[n + 1] - sPts[n]) / segL;
    vec3 pos = sPts[n] + T * (sTarget - sArc[n]) + corr;
    int nB = max(n - 3, 0), nF = min(n + 3, PRED_N - 2);
    vec3 Tb = normalize(sPts[nB + 1] - sPts[nB] + 1e-6);
    vec3 Tf = normalize(sPts[nF + 1] - sPts[nF] + 1e-6);
    vec3 toCam = transpose(camRot()) * vec3(0.0, 0.0, -1.0);
    vec3 ref = length(cross(T, toCam)) > 0.3 ? toCam : vec3(0.0, 1.0, 0.0);
    float bank = clamp(dot(cross(Tb, Tf), ref) * BANK_K, -1.15, 1.15);
    vec3 side0 = normalize(cross(T, ref));
    vec3 up0 = cross(side0, T);
    float cb = cos(bank), sb = sin(bank);
    vec3 sideF = cb * side0 + sb * up0;
    vec3 upF = -sb * side0 + cb * up0;
    float flare = 1.0 + 0.25 * abs(bank) * v;
    return pos + (sideF * oc.x + upF * oc.y) * flare;
}
vec3 frameSlot(int k, float a0, float cz, float L, vec3 corr) {
    vec3 slot = vec3(0.0);
    {
        float famp = mix(0.85, 1.15, smoothstep(0.1, 0.8, L));
        float sqc = clamp(cz, FS_SQ_MIN, 1.0);
        float reord = Cf(C_RD);
        if (FSEL >= 0) {
            slot = flightSpineSlot(FSEL, k, a0, sqc, famp, corr, u_beat_count, reord);
        } else {
            int sa = int(Cf(C_SHA) + 0.5) % N_FSHAPES;
            int sb = int(Cf(C_SHB) + 0.5) % N_FSHAPES;
            float turnM = smoothstep(0.0, TURN_MORPH_BEATS,
                                     mod(u_beat_count - Cf(C_SHT) + 1024.0, 1024.0));
            slot = mix(flightSpineSlot(sa, k, a0, sqc, famp, corr, u_beat_count, reord),
                       flightSpineSlot(sb, k, a0, sqc, famp, corr, u_beat_count, reord), turnM);
        }
    }
#if FIG_LAYER
    {
        float figW = smoothstep(0.0, 1.0, clamp(Cf(W_FIGAMP), 0.0, 1.0));
        if (figW > 0.001) {
            float famp2 = mix(0.85, 1.15, smoothstep(0.1, 0.8, L));
            slot = mix(slot, flightSpineSlot(FS_FIG_SHAPE, k, a0, clamp(cz, FS_SQ_MIN, 1.0), famp2, corr, u_beat_count, Cf(C_RD)), figW);
        }
    }
#endif
    return slot;
}
void main() {
    int f = int(gl_WorkGroupID.x), t = int(gl_LocalInvocationID.x);
    float one = Cf(C_PADONE);
    float dt = max(u_dt, 1e-4);
    vec4 hW = vec4(Cf(C_HW0), Cf(C_HW0 + 1), Cf(C_HW0 + 2), Cf(C_HW0 + 3));
    float hWE = Cf(C_HWE), hPocket = Cf(C_HPOCK);
    vec3 hSepX = vec3(Cf(C_HSEP), Cf(C_HSEP + 1), Cf(C_HSEP + 2));
    float stepB = (PRED_BACK + PRED_FWD) / float(PRED_N - 1);
    if (t < PRED_N) {
#if FORM_PATH_FROM_HEAD
        float spb = 60.0 / max(u_beat_bpm, 30.0);
        int i0t = int(round(PRED_BACK / stepB));
        if (t <= i0t) {
            float fbk = min(float(i0t - t) * stepB * spb / dt, float(HH_N - 3));
            int b0 = int(floor(fbk));
            vec3 pa = hhAt(f, b0).xyz, pb = hhAt(f, b0 + 1).xyz;
            sPts[t] = distance(pa, pb) < 0.6 ? mix(pa, pb, fbk - float(b0)) : pa;
        } else {
            vec3 hN = hhAt(f, 0).xyz;
            vec3 vv = (hN - hhAt(f, int(0.5 / dt)).xyz) / 0.5;
            sPts[t] = hN + vv * (float(t - i0t) * stepB * spb);
        }
#else
        vec3 ho = headOffAt(u_beat_count - PRED_BACK + float(t) * stepB, hW, hWE, hPocket, hSepX);
        sPts[t] = padPlane(f == 0 ? ho : pairSwing(ho, one), f, one);
#endif
    }
    barrier();
    int i0 = int(round(PRED_BACK / stepB));
    if (t == 0) {
        sArc[0] = 0.0;
        for (int n = 1; n < PRED_N; n++) sArc[n] = sArc[n - 1] + length(sPts[n] - sPts[n - 1]);
        float kMax = 0.0;
        int nMax = i0;
        float sgnTurn = 0.0;
        vec3 camF = camRot() * vec3(0.0, 0.0, 1.0);
        for (int n = 1; n < PRED_N - 1; n++) {
            if (n >= i0 - 1 && n <= i0 + 2) continue;
            vec3 u = sPts[n] - sPts[n - 1], v = sPts[n + 1] - sPts[n], w = sPts[n + 1] - sPts[n - 1];
            float den = length(u) * length(v) * length(w);
            if (den > 1e-9) {
                float kk = 2.0 * length(cross(u, v)) / den;
                if (kk > kMax) { kMax = kk; nMax = n; sgnTurn = sign(dot(cross(u, v), camF)); }
            }
        }
        sR = 1.0 / max(kMax, 1e-3);
        int i1 = min(i0 + 4, PRED_N - 1);
        float spdB = (sArc[i1] - sArc[i0]) / (float(i1 - i0) * stepB);
        imageStore(ldrImg, ivec2(f, 4), vec4(sR, spdB, float(nMax - i0) * stepB, sgnTurn));
    }
    barrier();
    int m = min(t, N_LMAX - 1), k = m % N_LEAD;
    bool live = t < N_LMAX;
    if (t == 0) sMinY = 0x7f7fffffu;
    float splitL = Cf(C_SPLV);
    int nAct = nLeaders(splitL);
    vec4 lp = imageLoad(ldrImg, ivec2(m, 2 * f));
    vec4 lv4 = imageLoad(ldrImg, ivec2(m, 2 * f + 1));
    vec4 pp = imageLoad(ldrImg, ivec2(leaderParent(m), 2 * f));
    vec4 pv = imageLoad(ldrImg, ivec2(leaderParent(m), 2 * f + 1));
    barrier();
    if (t < 3 && f == 0)
        imageStore(folImg, ivec2(N_LMAX, t), uvec4(0u));
    float df = leaderOff(m, splitL);
    uint fc = imageLoad(folImg, ivec2(m, 4 * f)).r;
    vec3 fcen = vec3(imageLoad(folImg, ivec2(m, 4 * f + 1)).r, imageLoad(folImg, ivec2(m, 4 * f + 2)).r,
                     imageLoad(folImg, ivec2(m, 4 * f + 3)).r) / max(float(fc), 1.0) / FOL_FIX - FOL_OFF;
    if (live) for (int r = 0; r < 4; r++) imageStore(folImg, ivec2(m, 4 * f + r), uvec4(0u));
    float L = clamp(Cf(C_LOUD) / max(Cf(C_LMAX), 0.05), 0.0, 1.0);
    int shA = int(Cf(C_SHA) + 0.5), shB = int(Cf(C_SHB) + 0.5);
    float morphB = Cf(C_POSSON) > 0.5 ? (int(Cf(C_AGG) + 0.5) == AGG_FIGS ? FIG_MORPH_BEATS : WASP_MORPH_BEATS) : FORM_MORPH_BEATS;
    float mB = smoothstep(0.0, morphB, mod(u_beat_count - Cf(C_SHT) + 1024.0, 1024.0));
    float vmaxL = mix(LEAD_VMAX, FRENZY_VMAX, clamp(Cf(C_FRENZY), 0.0, 1.0));
    float scale = FORM_R * mix(0.8, 1.25, smoothstep(0.1, 0.8, L));
#if FORM_PATH_FROM_HEAD
    vec3 hp = hhAt(f, 0).xyz;
#else
    vec3 hp = texelFetch(u_flk, ivec2(6 + f, 0), 0).xyz;
#endif
    vec3 corr = hp - sPts[i0];
    float a0 = sArc[i0];
    float bodyLen = mix(formLen(shA), formLen(shB), mB) * scale;
    float cz = clamp(TURN_FIT * 3.14159 * sR / max(bodyLen, 1e-3), CZ_MIN, 1.0);
    float cw = 1.0 / sqrt(cz);
    vec3 slotA = isWorld(shA) ? faceWorld(shA, worldSlot(shA, hp, k, df, f, u_beat_count)) : pathSlot(bodySlot(shA, k, df, u_beat_count) * scale, a0, cz, cw, corr, camFrameShape(shA));
    vec3 slotB = isWorld(shB) ? faceWorld(shB, worldSlot(shB, hp, k, df, f, u_beat_count)) : pathSlot(bodySlot(shB, k, df, u_beat_count) * scale, a0, cz, cw, corr, camFrameShape(shB));
    vec3 slot = mix(slotA, slotB, mB);
#if BRAID_FORM
    slot = braidSlot(k, a0, cz, cw, corr, Cf(C_RD));
#endif
#if FORM_FRAME
    slot = frameSlot(k, a0, cz, L, corr);
    {
        float bwF = smoothstep(0.0, 1.0, clamp(Cf(C_BRAIDW), 0.0, 1.0));
        if (bwF > 0.001) { gBraid = true; slot = mix(slot, frameSlot(k, a0, cz, L, corr), bwF); gBraid = false; }
    }
    {
        int gk = k / 3;
        float sw1 = smoothstep(0.0, 1.0, clamp(Cf(C_SPLITW), 0.0, 1.0)), sw2 = smoothstep(0.0, 1.0, clamp(Cf(C_SPL2W), 0.0, 1.0));
#if SPLIT_DEBUG >= 1
        sw1 = 1.0;
#endif
#if SPLIT_DEBUG >= 2
        sw2 = 1.0;
#endif
        float ang = ((gk & 1) == 1 ? 1.5707963 * sw1 : 0.0);
        if (ang > 1e-4) {
            vec3 c0 = vec3(0.0, CAM_TY, 0.0);
            vec3 cp = camRot() * (slot - c0);
            float ca = cos(ang), sa = sin(ang);
            cp.xy = vec2(ca * cp.x - sa * cp.y, sa * cp.x + ca * cp.y);
            slot = transpose(camRot()) * cp + c0;
        }
        if ((gk & 2) == 2 && sw2 > 1e-4) {
            float sg = (((gk & 1) ^ f) == 0) ? 1.0 : -1.0;
            slot += transpose(camRot()) * vec3(0.0, 0.0, -1.0) * (sg * SPLIT2_DZ * sw2);
        }
    }
#if EYE_ON
    {
        float eW = smoothstep(0.0, 1.0, clamp(Cf(C_EYE_W), 0.0, 1.0));
        int eT = int(Cf(C_EYE_T) + 0.5);
#if EYE_DEBUG > 0
        eW = 1.0; eT = EYE_DEBUG;
#endif
        if (eW > 0.001 && eT > 0) {
            int gi = f * N_LEAD + k;
            vec3 o = (eT == 1) ? eyeRings(gi, u_beat_count) : eyeArmillary(gi, u_beat_count);
            slot = mix(slot, transpose(camRot()) * o + vec3(0.0, CAM_TY, 0.0), eW);
        }
    }
#endif
#endif
    float possW = Cf(C_POSSW);
    if (u_pad_alive > 0.5 && u_pad_e_solo > 0.5 && Cf(C_POSSON) > 0.5
        && float(f) != mod(floor(u_beat_count / 4.0), 2.0)) possW = 0.0;
    if (possW > 0.001) {
        int agg = int(Cf(C_AGG) + 0.5);
        if (agg == AGG_ERUPT) {
            float q = mod(u_beat_count, POSS_BEATS);
            float env = smoothstep(0.0, 0.8, q) * (1.0 - smoothstep(5.5, 7.2, q));
            vec3 col = worldSlot(FORM_COLUMN, hp, k, df, f, u_beat_count);
            float by = FLOOR_Y + COL_BASE, st = 0.6 + 0.4 * smoothstep(0.15, 0.7, Cf(C_PUSH));
