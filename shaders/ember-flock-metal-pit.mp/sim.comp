        if (rs < HOLE_SLOT_R) slot = (rs > 1e-4 ? slot / rs : vec3(1.0, 0.0, 0.0)) * HOLE_SLOT_R;
    }
#if LEAD_EMBERS
    imageStore(ldrImg, ivec2(m, 2 * f), vec4(slot, 1.0));
