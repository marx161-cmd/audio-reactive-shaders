// Illusion-Diamond-Stained-Glass: common code, prepended to every pass.
//
// A faceted gem (facet table in the GENERATED STONE block),
// ray-traced with total internal reflection, Fresnel and dispersion, in front
// of a backlit stained-glass window (u_backdrop, with per-pane data in u_glass).
// The backlight rises with the bass and on onsets. Audio arrives in the `bands`
// texture: 120 semitone bands, 0..1.

uniform float u_bass, u_sub, u_lowmid, u_mid, u_highmid, u_presence, u_brilliance, u_onset;
uniform float u_rms, u_steer;
uniform sampler2D u_backdrop;
uniform sampler2D u_glass;

