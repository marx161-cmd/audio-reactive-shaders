uniform int   u_n;
uniform float u_H;
uniform float u_dt;

ivec3 cellId() { return ivec3(gl_GlobalInvocationID); }
bool outside(ivec3 p) { return any(lessThan(p, ivec3(0))) || any(greaterThanEqual(p, ivec3(u_n))); }
float cellH() { return 2.0 * u_H / float(u_n); }
vec3 cellPos(ivec3 p) { return ((vec3(p) + 0.5) / float(u_n) * 2.0 - 1.0) * u_H; }
vec3 toUVW(vec3 x) { return x / (2.0 * u_H) + 0.5; }

const ivec3 NB[6] = ivec3[6](ivec3(1, 0, 0), ivec3(-1, 0, 0), ivec3(0, 1, 0),
                             ivec3(0, -1, 0), ivec3(0, 0, 1), ivec3(0, 0, -1));

#define EPS        1e-3
uniform float u_eps;

#define VEL_TAU    4.0
#define VISC_A     0.35
#define STIR_R     0.08
#define STIR_RATE  10.0

#if defined(K_MASK) || defined(K_ADV_FWD) || defined(K_ADV_CORR) || defined(K_FORCE) || defined(K_DIV) \
 || defined(K_SMOOTH) || defined(K_MARK) || defined(K_RESTRICT) || defined(K_PROLONG) || defined(K_PROJECT)
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;
#endif

#ifdef K_MASK
layout(rgba16f, binding = 0) uniform writeonly image3D wallImg;
layout(r16f,    binding = 1) uniform writeonly image3D maskImg;
layout(rgba16f, binding = 2) uniform image3D velImg;
void main() {
    ivec3 p = cellId();
    if (outside(p)) return;
    bool fluid = all(greaterThan(p, ivec3(0))) && all(lessThan(p, ivec3(u_n - 1)));
    imageStore(wallImg, p, vec4(0.0, 0.0, 0.0, fluid ? 1.0 : 0.0));
    imageStore(maskImg, p, vec4(fluid ? 1.0 : 0.0));
    if (!fluid) imageStore(velImg, p, vec4(0.0));
}
#endif

#ifdef K_FORCE
layout(rgba16f, binding = 0) uniform image3D velImg;
uniform sampler2D u_worm;
void main() {
    ivec3 p = cellId();
    if (outside(p)) return;
    vec4 v = imageLoad(velImg, p);
    if (v.w < 0.5) return;
    vec3 x = cellPos(p);
    for (int k = 0; k < 2; k++) {
        vec3 a = texelFetch(u_worm, ivec2(2 + k, 0), 0).xyz;
        vec3 b = texelFetch(u_worm, ivec2(k, 0), 0).xyz;
        vec3 ab = b - a;
        float h = clamp(dot(x - a, ab) / max(dot(ab, ab), 1e-12), 0.0, 1.0);
        float d = length(x - a - ab * h);
        float g = exp(-(d / STIR_R) * (d / STIR_R));
        vec3 wv = ab / max(u_dt, 1e-4);
        v.xyz += (wv - v.xyz) * (1.0 - exp(-u_dt * STIR_RATE * g));
    }
    v.xyz *= exp(-u_dt / VEL_TAU);
    imageStore(velImg, p, v);
}
#endif
#ifdef K_ADV_FWD
layout(rgba16f, binding = 0) uniform writeonly image3D outImg;
uniform sampler3D u_src;
uniform sampler3D u_vel;

void main() {
    ivec3 p = cellId();
    if (outside(p)) return;
    vec3 x = cellPos(p);
    vec3 u = texelFetch(u_vel, p, 0).xyz;
    imageStore(outImg, p, texture(u_src, toUVW(x - u_dt * u)));
}
#endif

#ifdef K_ADV_CORR
layout(rgba16f, binding = 0) uniform writeonly image3D outImg;
layout(r16f,    binding = 1) uniform readonly image3D maskImg;
uniform sampler3D u_src;
uniform sampler3D u_fwd;
uniform sampler3D u_vel;

void main() {
    ivec3 p = cellId();
    if (outside(p)) return;
    vec3 x = cellPos(p);
    vec3 u = texelFetch(u_vel, p, 0).xyz;
    vec4 fh = texelFetch(u_fwd, p, 0);
    vec4 back = texture(u_fwd, toUVW(x + u_dt * u));
    vec4 res = fh + 0.5 * (texelFetch(u_src, p, 0) - back);

    vec3 g = toUVW(x - u_dt * u) * float(u_n) - 0.5;
    ivec3 b0 = ivec3(floor(g));
    vec4 lo = vec4(1e9), hi = vec4(-1e9);
    for (int k = 0; k < 8; k++) {
        ivec3 c = clamp(b0 + ivec3(k & 1, (k >> 1) & 1, k >> 2), ivec3(0), ivec3(u_n - 1));
        vec4 v = texelFetch(u_src, c, 0);
        lo = min(lo, v);
        hi = max(hi, v);
    }
    res = clamp(res, lo, hi);
    res.a = imageLoad(maskImg, p).r;
    imageStore(outImg, p, res);
}
#endif

#ifdef K_SMOOTH
layout(r32f, binding = 0) uniform image3D qImg;
layout(r32f, binding = 1) uniform readonly image3D bImg;
layout(r16f, binding = 2) uniform readonly image3D mImg;
uniform int u_parity;
uniform int u_wallOnly;

void main() {
    ivec3 p = cellId();
    if (outside(p)) return;
    if (((p.x + p.y + p.z) & 1) != u_parity) return;
    float mp = imageLoad(mImg, p).r;
    if (mp < 0.5) return;
    if (u_wallOnly == 1 && mp < 1.25) return;
    float s = 0.0, cnt = 0.0;
    for (int k = 0; k < 6; k++) {
        ivec3 q = p + NB[k];
        if (outside(q) || imageLoad(mImg, q).r < 0.5) continue;
        s += imageLoad(qImg, q).r;
        cnt += 1.0;
    }
    imageStore(qImg, p, vec4((s - imageLoad(bImg, p).r) / (cnt + u_eps)));
}
#endif

#ifdef K_MARK
layout(r16f, binding = 0) uniform image3D mImg;

void main() {
    ivec3 p = cellId();
    if (outside(p)) return;
    if (imageLoad(mImg, p).r < 0.5) return;
    for (int k = 0; k < 6; k++) {
        ivec3 q = p + NB[k];
        if (outside(q) || imageLoad(mImg, q).r < 0.5) { imageStore(mImg, p, vec4(1.5)); return; }
    }
}
#endif

#ifdef K_RESTRICT
layout(r32f, binding = 0) uniform readonly image3D qfImg;
layout(r32f, binding = 1) uniform readonly image3D bfImg;
layout(r16f, binding = 2) uniform readonly image3D mfImg;
layout(r32f, binding = 3) uniform writeonly image3D qcImg;
layout(r32f, binding = 4) uniform writeonly image3D bcImg;
layout(r16f, binding = 5) uniform writeonly image3D mcImg;

void main() {
    ivec3 c = cellId();
    if (outside(c)) return;
    int nf = 2 * u_n;
    float sumR = 0.0, sumM = 0.0;
    for (int k = 0; k < 8; k++) {
        ivec3 f = 2 * c + ivec3(k & 1, (k >> 1) & 1, k >> 2);
        float m = imageLoad(mfImg, f).r;
        sumM += min(m, 1.0);
        if (m < 0.5) continue;
        float qi = imageLoad(qfImg, f).r;
        float s = 0.0, cnt = 0.0;
        for (int j = 0; j < 6; j++) {
            ivec3 q = f + NB[j];
            if (any(lessThan(q, ivec3(0))) || any(greaterThanEqual(q, ivec3(nf)))) continue;
            if (imageLoad(mfImg, q).r < 0.5) continue;
            s += imageLoad(qfImg, q).r;
            cnt += 1.0;
        }
        sumR += imageLoad(bfImg, f).r - (s - (cnt + u_eps) * qi);
    }
    imageStore(qcImg, c, vec4(0.0));
    imageStore(bcImg, c, vec4(0.5 * sumR));
    imageStore(mcImg, c, vec4(sumM / 8.0));
}
#endif

#ifdef K_PROLONG
layout(r32f, binding = 0) uniform image3D qfImg;
layout(r16f, binding = 1) uniform readonly image3D mfImg;
layout(r32f, binding = 2) uniform readonly image3D qcImg;
layout(r16f, binding = 3) uniform readonly image3D mcImg;

void main() {
    ivec3 p = cellId();
    if (outside(p)) return;
    if (imageLoad(mfImg, p).r < 0.5) return;
    int nc = u_n / 2;
    ivec3 c0 = p / 2;
    ivec3 o = 2 * (p & 1) - 1;
    float sum = 0.0, wsum = 0.0;
    for (int k = 0; k < 8; k++) {
        ivec3 sel = ivec3(k & 1, (k >> 1) & 1, k >> 2);
        ivec3 c = c0 + sel * o;
        if (any(lessThan(c, ivec3(0))) || any(greaterThanEqual(c, ivec3(nc)))) continue;
        if (imageLoad(mcImg, c).r < 0.5) continue;
        vec3 w3 = mix(vec3(0.75), vec3(0.25), vec3(sel));
        float w = w3.x * w3.y * w3.z;
        sum += w * imageLoad(qcImg, c).r;
        wsum += w;
    }
    if (wsum > 0.0) imageStore(qfImg, p, vec4(imageLoad(qfImg, p).r + sum / wsum));
}
#endif

#ifdef K_PROJECT
layout(rgba16f, binding = 0) uniform image3D velImg;
layout(r32f,    binding = 1) uniform readonly image3D qImg;
layout(rgba16f, binding = 2) uniform readonly image3D wallImg;

void main() {
    ivec3 p = cellId();
    if (outside(p)) return;
    vec4 w = imageLoad(wallImg, p);
    if (w.w < 0.5) { imageStore(velImg, p, vec4(w.xyz, 0.0)); return; }
    float qc = imageLoad(qImg, p).r;
    float qn[6];
    for (int k = 0; k < 6; k++) {
        ivec3 q = p + NB[k];
        qn[k] = (!outside(q) && imageLoad(wallImg, q).w > 0.5) ? imageLoad(qImg, q).r : qc;
    }
    vec4 v = imageLoad(velImg, p);
    v.xyz -= 0.5 * vec3(qn[0] - qn[1], qn[2] - qn[3], qn[4] - qn[5]);
    imageStore(velImg, p, v);
}
#endif

#ifdef K_DIV
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;
layout(r32f,    binding = 0) uniform writeonly image3D bImg;
layout(rgba16f, binding = 1) uniform readonly image3D velImg;
layout(rgba16f, binding = 2) uniform readonly image3D wallImg;
vec3 uAt(ivec3 q) {
    if (outside(q)) return vec3(0.0);
    vec4 w = imageLoad(wallImg, q);
    return w.w > 0.5 ? imageLoad(velImg, q).xyz : w.xyz;
}
void main() {
    ivec3 p = cellId();
    if (outside(p)) return;
    if (imageLoad(wallImg, p).w < 0.5) { imageStore(bImg, p, vec4(0.0)); return; }
    float D = 0.5 * ((uAt(p + NB[0]).x - uAt(p + NB[1]).x)
                   + (uAt(p + NB[2]).y - uAt(p + NB[3]).y)
                   + (uAt(p + NB[4]).z - uAt(p + NB[5]).z));
    imageStore(bImg, p, vec4(D));
}
#endif

#ifdef K_VISC
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;
layout(rgba16f, binding = 0) uniform writeonly image3D dstImg;
uniform sampler3D u_src;
void main() {
    ivec3 p = cellId();
    if (outside(p)) return;
    vec4 c = texelFetch(u_src, p, 0);
    if (c.w < 0.5) { imageStore(dstImg, p, c); return; }
    vec3 s = vec3(0.0);
    float n = 0.0;
    for (int k = 0; k < 6; k++) {
        ivec3 q = p + NB[k];
        if (outside(q)) continue;
        vec4 o = texelFetch(u_src, q, 0);
        if (o.w < 0.5) continue;
        s += o.xyz; n += 1.0;
    }
    if (n > 0.0) c.xyz += (s / n - c.xyz) * VISC_A;
    imageStore(dstImg, p, c);
}
#endif

